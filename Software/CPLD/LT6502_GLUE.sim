PIN  22 =  A3 
PIN  21 =  A4 
PIN  20 =  A5 
PIN  19 =  A6 
PIN  17 =  A7 
PIN  16 =  A8 
PIN  14 =  A9 
PIN  13 =  A10 
PIN  12 =  A11 
PIN  10 =  A12 
PIN   9 =  A13 
PIN   8 =  A14 
PIN   7 =  A15 
PIN  87 =  CLK 
PIN  83 =  CLK_OUT 
PIN  60 =  D0 
PIN  58 =  D1 
PIN  57 =  D2 
PIN  56 =  D3 
PIN  55 =  D4 
PIN  54 =  D5 
PIN  53 =  D6 
PIN  52 =  D7 
PIN  94 = !LED 
PIN  75 =  PHI2 
PIN  84 =  Q0 
PIN   0 =  Q1 
PIN   0 =  Q2 
PIN  42 = !RAM_nCS0 
PIN  37 = !RD 
PIN  48 = !RD_FT 
PIN  93 = !RESET 
PIN  46 = !ROM_nCS 
PIN  45 = !ROM_nR 
PIN  36 = !RW 
PIN  49 =  RXF 
