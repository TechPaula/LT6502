%FIELD
%END

%EQUATION
CLK_OUT =>
    CLK

D0 =>
    !RXF

D0.oe  =>
    !A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & RnW

D1 =>
    !TXE

D1.oe  =>
    !A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & RnW

FT_CS =>
    A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15

LED =>
    A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15

PHI2.d  =>
    !PHI2
  # PHI2 & !Q2
  # PHI2 & !Q1
  # PHI2 & !Q0

PHI2.ar  =>
    RESET

PHI2.ck  =>
    CLK

Q0.d  =>
    !PHI2
  # PHI2 & !Q0

Q0.ar  =>
    RESET

Q0.ck  =>
    CLK

Q1.d  =>
    !PHI2 & !SLOW0
  # PHI2 & Q0 & !Q1
  # PHI2 & !Q0 & Q1

Q1.ar  =>
    RESET

Q1.ck  =>
    CLK

Q2.d  =>
    !PHI2 & !SLOW1
  # PHI2 & !Q1 & Q2
  # PHI2 & !Q0 & Q2
  # PHI2 & Q0 & Q1 & !Q2

Q2.ar  =>
    RESET

Q2.ck  =>
    CLK

RAM_nCS0 =>
    !A15

RD =>
    PHI2 & RnW

RD_FT =>
    A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & PHI2 & RnW

ROM_nCS =>
    1 

ROM_nR =>
    A14 & A15

RW =>
    PHI2 & !RnW

WR_FT =>
    A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & PHI2 & !RnW

%END
