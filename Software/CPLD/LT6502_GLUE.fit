CLK_OUT = CLK;

D0 = !RXF;

D1 = !TXE;

!LED = (A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15);

!PHI2.D = (PHI2.Q & Q0.Q & Q1.Q & Q2.Q);

!Q0.D = (PHI2.Q & Q0.Q);

Q1.D = ((PHI2.Q & Q0.Q & !Q1.Q)
	# (PHI2.Q & !Q0.Q & Q1.Q)
	# (!PHI2.Q & SLOW0));

Q2.D = ((PHI2.Q & !Q1.Q & Q2.Q)
	# (PHI2.Q & Q2.Q & !Q0.Q)
	# (PHI2.Q & Q1.Q & !Q2.Q & Q0.Q)
	# (!PHI2.Q & SLOW1));

RAM_nCS0 = A15;

!RD = (PHI2.Q & RnW);

!RD_FT = (A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & PHI2.Q & RnW);

ROM_nCS = 0;

!ROM_nR = (A14 & A15);

!RW = (PHI2.Q & !RnW);

WR_FT = (A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & PHI2.Q & !RnW);

D0.OE = (!A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & RnW);

D1.OE = (!A0 & A4 & A5 & A6 & A7 & A8 & A9 & A10 & A11 & A12 & A13 & !A14 & A15 & RnW);

PHI2.C = CLK;

PHI2.AR = !RESET;

Q0.C = CLK;

Q0.AR = !RESET;

Q1.C = CLK;

Q1.AR = !RESET;

Q2.C = CLK;

Q2.AR = !RESET;


