Name     PC6502_CPU_14;
PartNo   ;
Date     15/08/24;
Revision ;
Designer Shonky/Paula;
Company  ;
Assembly ;
Location ;
Device	  f1508isptqfp100;

/*********************************************************
 *                     INPUT PINS                        *
 *********************************************************/


/* SYSTEM signals */
Pin 87 = CLK;       /* MAIN OSC CLOCK IN */
Pin 93 = !RESET;    /* GLOBAL RESET IN */
Pin 84 = Q0;        /* Sent to expansion header, CLK/2 OUT (not stretched) */
Pin 83 = CLK_OUT;   /* sent to expansion header OUT */

Pin 96 = !SLOW0;    /* CPU Clock Slow bit 0, INPUT */
Pin 97 = !SLOW1;    /* CPU Clock Slow bit 1, INPUT */

Pin 37 = !RD;       /* OUTPUT */
Pin 36 = !RW;       /* OUTPUT */

Pin 94 = !LED;      /* Test LED output */


/* CPU signals */
Pin 75 = PHI2;      /* CPU_CLK OUTPUT */
Pin 90 = RnW;       /* INPUT */


/* ROM Enables */
Pin 45 = !ROM_nR;    /* OUTPUT */
Pin 46 = !ROM_nCS;   /* OUTPUT */


/* RAM CS */
Pin 42 = !RAM_nCS0;    /* OUTPUT */
/* Pin 40 = !RAM_nCS1; */


/* FT245, Console, Signals */
Pin 48 = !RD_FT;           /* OUTPUT */
Pin 47 = WR_FT;            /* OUTPUT */
Pin 49 = RXF;	             /* BIT 0 of 6850 register, INPUT */
Pin 50 = TXE;	             /* BIT 1 of 6850 register, INPUT */
                           /* Had to swap pin 49/50, no idea why */


/* Address bus all are INPUT */
Pin 25 = A0;
Pin 24 = A1;
Pin 23 = A2;
Pin 22 = A3;
Pin 21 = A4;
Pin 20 = A5;
Pin 19 = A6;
Pin 17 = A7;
Pin 16 = A8;
Pin 14 = A9;
Pin 13 = A10;
Pin 12 = A11;
Pin 10 = A12;
Pin  9 = A13;
Pin  8 = A14;
Pin  7 = A15;


/* Data bus */
Pin 60 = D0;
Pin 58 = D1;
Pin 57 = D2;
Pin 56 = D3;
Pin 55 = D4;
Pin 54 = D5;
Pin 53 = D6;
Pin 52 = D7;



/*********************************************************
 *                        PINNODES                       *
 *********************************************************/

/* Clock Stretch nodes */
Pinnode  0  = Q1;
Pinnode  0  = Q2;

/*********************************************************
 *                        VARIABLES                      *
 *********************************************************/




/*********************************************************
 *                     LOGIC EQUATIONS                   *
 *********************************************************/


/* Clock Stretching */
Q0.ck = CLK;
Q1.ck = CLK;
Q2.ck = CLK;
PHI2.ck = CLK;

Q0.ar = RESET;
Q1.ar = RESET;
Q2.ar = RESET;
PHI2.ar = RESET;

Q0.D = !PHI2
       # PHI2 & !Q0;

Q1.D = !PHI2 & !SLOW0
       # PHI2 & !Q1 & Q0
       # PHI2 & Q1 & !Q0;

Q2.D = !PHI2 & !SLOW1
       # PHI2 & Q2 & !Q1
       # PHI2 & Q2 & !Q0	
       # PHI2 & !Q2 & Q1 & Q0;

PHI2.D = !PHI2
       # PHI2 & !Q2	
       # PHI2 & !Q1
       # PHI2 & !Q0	
       # !PHI2 & Q2 & Q1 & Q0;







/* FT245 Serial port 0xBFF0 - 0xBFFF */			
FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;

RD_FT = PHI2 & FT_CS & A0 &  RnW;		/* 0xA001 */
WR_FT = PHI2 & FT_CS & A0 & !RnW;		/* 0xA001 */ 

D0.oe = FT_CS & !A0 & RnW; 			/* 0xA000 */
D1.oe = FT_CS & !A0 & RnW; 			/* 0xA000 */

D0 = !RXF;				
D1 = !TXE;			


/* ROM 0xC000 - 0xFF */
ROM_nR  = A15 & A14;   /* ROM Read address */
ROM_nCS = 'b'1;        /* ROM chip select always active */

/* RAM 0x0000 - 0x7FFF */			
RAM_nCS0 = !A15;	
RW = PHI2 & !RnW;
RD = PHI2 & RnW;

/* system wide logic */
CLK_OUT = CLK;
LED = FT_CS;

/* END OF FILE */
/*****************************************************/