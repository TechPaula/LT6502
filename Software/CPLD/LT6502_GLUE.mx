Name     LT6502_GLUE;
PartNo   ;
Date     02/01/26;
Revision ;
Designer Paula;
Company  ;
Assembly ;
Location ;
Device	  f1508isptqfp100;

/*********************************************************
 *                     INPUT PINS                        *
 *********************************************************/


/* SYSTEM signals */
Pin 87 = CLK;       /* MAIN OSC CLOCK IN */
Pin 93 = !RESET;    /* GLOBAL RESET IN */
Pin 84 = CLK_OUT;   /* Sent to expansion header, WAS Q0 but VIA/ACIA connected to pin 83, oops */
Pin 83 = Q0;        /* sent to expansion header OUT, NOW CLK/2, same speed as CPU unstretched */

Pin 96 = !SLOW0;    /* CPU Clock Slow bit 0, INPUT */
Pin 97 = !SLOW1;    /* CPU Clock Slow bit 1, INPUT */

Pin 37 = !RD;       /* OUTPUT */
Pin 36 = !RW;       /* OUTPUT */

Pin 94 = !LED;      /* Test LED output */


/* CPU signals */
Pin 75 = PHI2;      /* CPU_CLK OUTPUT */
Pin 90 = RnW;       /* INPUT */


/* ROM Enables */
Pin 45 = !ROM_nR;    /* OUTPUT */
Pin 46 = !ROM_nCS;   /* OUTPUT */


/* RAM CS */
Pin 42 = !RAM_nCS0;    /* OUTPUT */
Pin 40 = !RAM_nCS1;    /* OUTPUT */


/* FT245, Console, Signals */
Pin 48 = !RD_FT;           /* OUTPUT */
Pin 47 = WR_FT;            /* OUTPUT */
Pin 49 = RXF;	             /* BIT 0 of 6850 register, INPUT */
Pin 50 = TXE;	             /* BIT 1 of 6850 register, INPUT */
                           /* Had to swap pin 49/50, Labels swapped on schematic, DOH! */

/* 65C22 VIA */
Pin 76 = !VIA_nCS;


/* Expansion card */
Pin 78 = !EXP_nCS;


/* Compact Flash */
Pin 80 = !CF_nRES;       /* OUT, was nCS, but I swapped pins on the schematic, DOH! */
Pin 81 = !CF_nCS;        /* OUT, was nRES, but I swapped pins on the schematic, DOH! */


/* Keyboard Serial port, 65C51 */
Pin 77 = !ACIA_nCS;


/* Display */
Pin 98 = !DISP_nCS;
Pin 27 = DISP_DATA_EN;    /* OUT, databus level shifter enable */
Pin  6 = DISP_BL;
Pin 99 = !DISP_nRES;
Pin 100 = DISP_E;         /* OUT, 6800 "E" signal


/* Beeper */
Pin 92 = BEEPER;


/* Address bus all are INPUT */
Pin 25 = A0;
Pin 24 = A1;
Pin 23 = A2;
Pin 22 = A3;
Pin 21 = A4;
Pin 20 = A5;
Pin 19 = A6;
Pin 17 = A7;
Pin 16 = A8;
Pin 14 = A9;
Pin 13 = A10;
Pin 12 = A11;
Pin 10 = A12;
Pin  9 = A13;
Pin  8 = A14;
Pin  7 = A15;


/* Data bus */
Pin 60 = D0;
Pin 58 = D1;
Pin 57 = D2;
Pin 56 = D3;
Pin 55 = D4;
Pin 54 = D5;
Pin 53 = D6;
Pin 52 = D7;



/*********************************************************
 *                        PINNODES                       *
 *********************************************************/

/* Clock Stretch nodes */
Pinnode  0  = Q1;
Pinnode  0  = Q2;





/*********************************************************
 *                     Clock Bits and bobs               *
 *********************************************************/


/* Clock Stretching */
Q0.ck = CLK;
Q1.ck = CLK;
Q2.ck = CLK;
PHI2.ck = CLK;

Q0.ar = RESET;
Q1.ar = RESET;
Q2.ar = RESET;
PHI2.ar = RESET;

Q0.D = !PHI2
       # PHI2 & !Q0;

Q1.D = !PHI2 & !(SLOW0 # DISP_nCS)
       # PHI2 & !Q1 & Q0
       # PHI2 & Q1 & !Q0;

Q2.D = !PHI2 & !SLOW1
       # PHI2 & Q2 & !Q1
       # PHI2 & Q2 & !Q0	
       # PHI2 & !Q2 & Q1 & Q0;

PHI2.D = !PHI2
       # PHI2 & !Q2	
       # PHI2 & !Q1
       # PHI2 & !Q0	
       # !PHI2 & Q2 & Q1 & Q0;

/*********************************************************
 *                     Decode & glue                     *
 *********************************************************/


/* FT245 Serial port 0xBFF0 - 0xBFFF */			
FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;

RD_FT = PHI2 & FT_CS & A0 &  RnW;		/* 0xBFF1 */
WR_FT = PHI2 & FT_CS & A0 & !RnW;		/* 0xBFF1 */ 

D0.oe = FT_CS & !A0 & RnW; 			/* 0xBFF0 */

D1.oe = FT_CS & !A0 & RnW; 			/* 0xBFF0 */

D0 = !RXF;				
D1 = !TXE;			


/* Keyboard ACIA - 0xBFE0 - 0xBFEF */
ACIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & !A4;
 
/* Display 0xBFD0 - 0xBFDF */
DISP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & A4;
DISP_DATA_EN = DISP_nCS;
DISP_E = DISP_nCS & PHI2 & !Q0; /*DISP_nCS & Q0;*/
DISP_BL = 'b'1;
DISP_nRES = RESET;


/* Onboard VIA 65c22 0xBFC0 - 0xBFCF */
VIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & !A4;


/* Compact Flash 0xBFB0 - 0xBFBF */
CF_nCS  = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & A4;
CF_nRES = RESET;


/* Beeper, a simple SR latch for now - 0xBFA0 - 0xBFAF */
BEEP_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & !A4;
BEEP_S = D2 & BEEP_CS;
BEEP_R = !D2 & BEEP_CS;
BEEPER =  (BEEPER & !BEEP_R) # BEEP_S;


/* Expansion Slot 0xBE00 - 0xBEFF*/
EXP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & !A8;


/***********************/
/* GAP 0xBFF0 - 0xBFCF */
/***********************/


/* ROM 0xC000 - 0xFFFF */
ROM_nR  = A15 & A14;   /* ROM Read address */
ROM_nCS = 'b'1;        /* ROM chip select always active */


/* RAM bank 0 0x0000 - 0x7FFF */			
RAM_nCS0 = !A15;	
RW = PHI2 & !RnW & !FT_CS ;
RD = PHI2 &  RnW & !FT_CS;


/* RAM bank 1 0x8000 - 0xBDFF */
RAM_nCS1 = A15 & !A14 & !FT_CS & !ACIA_nCS & !DISP_nCS & !VIA_nCS & !CF_nCS & !EXP_nCS & !BEEP_CS;




/* system wide logic */
CLK_OUT = CLK;
LED = CF_nCS;



/* END OF FILE */
/*****************************************************/