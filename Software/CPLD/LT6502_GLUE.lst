162:
163:
164:/* FT245 Serial port 0xBFF0 - 0xBFFF */                 
165:FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;
166:
167:RD_FT = PHI2 & FT_CS & A0 &  RnW;               /* 0xBFF1 */
168:WR_FT = PHI2 & FT_CS & A0 & !RnW;               /* 0xBFF1 */ 
169:D0.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
170:D1.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
171:
172:D0 = !RXF;                              
173:D1 = !TXE;                      
174:
175:
176:/* Keyboard ACIA - 0xBFE0 - 0xBFEF */
177:ACIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & !A4;
178: 
179:/* Display 0xBFD0 - 0xBFDF */
180:DISP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & A4  & !A3 & !A2;
181:DISP_DATA_EN = DISP_nCS & !A1;
182:DISP_E = DISP_nCS & PHI2 & !Q0  & !A1;
183:DISP_BL = 'b'1;
184:DISP_nRES = RESET;
185:D3.oe = DISP_nCS & A1;
186:D3 = !DISP_nWT;
187:
188:/* Onboard VIA 65c22 0xBFC0 - 0xBFCF */
189:VIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & !A4;
190:
191:
192:/* Compact Flash 0xBFB0 - 0xBFBF */
193:CF_nCS  = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & A4;
194:CF_nRES = RESET;
195:
196:
197:/* Beeper, a simple SR latch for now - 0xBFA0 - 0xBFAF */
198:BEEP_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & !A4;
199:BEEP_S = D2 & BEEP_CS;
200:BEEP_R = !D2 & BEEP_CS;
201:BEEPER =  (BEEPER & !BEEP_R) # BEEP_S;
202:
203:
204:/* Expansion Slot 0xBE00 - 0xBEFF*/
205:EXP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & !A8;
206:
207:
208:/***********************/
209:/* GAP 0xBFF0 - 0xBFCF */
210:/***********************/
211:
212:
213:/* ROM 0xC000 - 0xFFFF */
214:ROM_nR  = A15 & A14;   /* ROM Read address */
215:ROM_nCS = 'b'1;        /* ROM chip select always active */

