108:Q2.ck = CLK;
109:PHI2.ck = CLK;
110:
111:Q0.ar = RESET;
112:Q1.ar = RESET;
113:Q2.ar = RESET;
114:PHI2.ar = RESET;
115:
116:Q0.D = !PHI2
117:       # PHI2 & !Q0;
118:
119:Q1.D = !PHI2 & !SLOW0
120:       # PHI2 & !Q1 & Q0
121:       # PHI2 & Q1 & !Q0;
122:
123:Q2.D = !PHI2 & !SLOW1
124:       # PHI2 & Q2 & !Q1
125:       # PHI2 & Q2 & !Q0        
126:       # PHI2 & !Q2 & Q1 & Q0;
127:
128:PHI2.D = !PHI2
129:       # PHI2 & !Q2     
130:       # PHI2 & !Q1
131:       # PHI2 & !Q0     
132:       # !PHI2 & Q2 & Q1 & Q0;
133:
134:
135:
136:
137:
138:
139:
140:/* FT245 Serial port 0xA000 - 0xA00F */                 
141:FT_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & !A9 & !A8 & !A7 & !A6 & !A5 & !A4;
142:
143:RD_FT = PHI2 & FT_CS & A0 &  RnW;               /* 0xA001 */
144:WR_FT = PHI2 & FT_CS & A0 & !RnW;               /* 0xA001 */ 
145:
146:D0.oe = FT_CS & !A0 & RnW;                      /* 0xA000 */
147:D1.oe = FT_CS & !A0 & RnW;                      /* 0xA000 */
148:
149:D0 = !RXF;                              
150:D1 = !TXE;                      
151:
152:
153:/* ROM 0xC000 - 0xFFFF */
154:ROM_nR  = A15 & A14;   /* ROM Read address */
155:ROM_nCS = 'b'1;        /* ROM chip select always active */
156:
157:/* RAM 0x0000 - 0x7FFF */                       
158:RAM_nCS0 = !A15;        
159:RW = PHI2 & !RnW;
160:RD = PHI2 & RnW;
161:

