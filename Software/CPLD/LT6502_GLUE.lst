114:/*********************************************************
115: *                        PINNODES                       *
116: *********************************************************/
117:
118:/* Clock Stretch nodes */
119:Pinnode  0  = Q1;
120:Pinnode  0  = Q2;
121:Pinnode  0  = BLBR0;
122:Pinnode  0  = BLBR1;
123:Pinnode  0  = BLBR2;
124:Pinnode  0  = BLBR3;
125:Pinnode  0  = BLQ0;
126:Pinnode  0  = BLQ1;
127:Pinnode  0  = BLQ2;
128:
129:
130:
131:BLBR0 = 'b'0;
132:BLBR1 = 'b'0;
133:BLBR2 = 'b'0;
134:BLBR3 = 'b'0;
135:
136:
137:
138:
139:
140:
141:
142:/*********************************************************
143: *                     Clock Bits and bobs               *
144: *********************************************************/
145:
146:
147:/* Clock Stretching */
148:Q0.ck = CLK;
149:Q1.ck = CLK;
150:Q2.ck = CLK;
151:PHI2.ck = CLK;
152:
153:Q0.ar = RESET;
154:Q1.ar = RESET;
155:Q2.ar = RESET;
156:PHI2.ar = RESET;
157:
158:Q0.D = !PHI2
159:       # PHI2 & !Q0;
160:
161:Q1.D = !PHI2 & !(SLOW0 # DISP_nCS)

LISTING FOR LOGIC DESCRIPTION FILE: LT6502_GLUE.pld                  Page 4

CUPL(WM): Universal Compiler for Programmable Logic
Version 5.0a Serial# 60008009
Copyright (c) 1983, 1998 Logical Devices, Inc.
Created Thu Jan 22 18:53:32 2026

162:       # PHI2 & !Q1 & Q0
163:       # PHI2 & Q1 & !Q0;
164:
165:Q2.D = !PHI2 & !SLOW1
166:       # PHI2 & Q2 & !Q1
167:       # PHI2 & Q2 & !Q0        
168:       # PHI2 & !Q2 & Q1 & Q0;
169:
170:PHI2.D = !PHI2
171:       # PHI2 & !Q2     
172:       # PHI2 & !Q1
173:       # PHI2 & !Q0     
174:       # !PHI2 & Q2 & Q1 & Q0;
175:
176:
177:/*********************************************************
178: *                     Decode & glue                     *
179: *********************************************************/
180:
181:
182:/* FT245 Serial port 0xBFF0 - 0xBFFF */                 
183:FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;
184:
185:RD_FT = PHI2 & FT_CS & A0 &  RnW;               /* 0xBFF1 */
186:WR_FT = PHI2 & FT_CS & A0 & !RnW;               /* 0xBFF1 */ 
187:D0.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
188:D1.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
189:
190:D0 = !RXF;                              
191:D1 = !TXE;                      
192:
193:
194:/* Keyboard ACIA - 0xBFE0 - 0xBFEF */
195:ACIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & !A4;
196: 
197:/* Display 0xBFD0 - 0xBFDF */
198:DISP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & A4  & !A3 & !A2;
199:DISP_DATA_EN = DISP_nCS & !A1;
200:DISP_E = DISP_nCS & PHI2 & !Q0  & !A1;
201:DISP_BL = 'b'1; /* toggling this causes board resets */
202:DISP_nRES = RESET;
203:D3.oe = DISP_nCS & A1;
204:D3 = !DISP_nWT;
205:
206:/* Onboard VIA 65c22 0xBFC0 - 0xBFCF */
207:VIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & !A4;
208:
209:
210:/* Compact Flash 0xBFB0 - 0xBFBF */
211:CF_nCS  = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & A4;
212:CF_nRES = RESET;
213:
214:
215:/* Beeper, a simple SR latch for now - 0xBFA0 - 0xBFAF */

LISTING FOR LOGIC DESCRIPTION FILE: LT6502_GLUE.pld                  Page 5

