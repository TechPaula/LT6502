216:BEEP_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & !A4;
217:BEEP_S = D2 & BEEP_CS;
218:BEEP_R = !D2 & BEEP_CS;
219:BEEPER =  (BEEPER & !BEEP_R) # BEEP_S;
220:
221:
222:/* Expansion Slot 0xBE00 - 0xBEFF*/
223:EXP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & !A8;
224:
225:
226:/***********************/
227:/* GAP 0xBFF0 - 0xBFCF */
228:/***********************/
229:
230:
231:/* ROM 0xC000 - 0xFFFF */
232:ROM_nR  = A15 & A14;   /* ROM Read address */
233:ROM_nCS = 'b'1;        /* ROM chip select always active */
234:
235:
236:/* RAM bank 0 0x0000 - 0x7FFF */                        
237:RAM_nCS0 = !A15;        
238:RW = PHI2 & !RnW & !FT_CS ;
239:RD = PHI2 &  RnW & !FT_CS;
240:
241:
242:/* RAM bank 1 0x8000 - 0xBDFF */
243:RAM_nCS1 = A15 & !A14 & !FT_CS & !ACIA_nCS & !DISP_nCS & !VIA_nCS & !CF_nCS & !EXP_nCS & !BEEP_CS;
244:
245:
246:
247:
248:/* system wide logic */
249:CLK_OUT = CLK;
250:LED = CF_nCS;
251:
252:
253:
254:/* END OF FILE */
255:/*****************************************************/
