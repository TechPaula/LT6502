Created Sat Jan 03 17:02:25 2026

162:WR_FT = PHI2 & FT_CS & A0 & !RnW;               /* 0xBFF1 */ 
163:
164:D0.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
165:
166:D1.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
167:
168:D0 = !RXF;                              
169:D1 = !TXE;                      
170:
171:
172:/* Keyboard Serial port, 6551, 0xBFE0 - 0xBFEF */
173:ACIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & !A4;
174: 
175:/***********************/
176:/* GAP 0xBFF0 - 0xBFCF */
177:/***********************/
178:
179:/* Display 0xBFD0 - 0xBFDF */
180:DISP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & A4;
181:DISP_DATA_EN = DISP_nCS;
182:DISP_BL = 'b'1;
183:
184:
185:/* Onboard VIA 65c22 0xBFC0 - 0xBFCF */
186:VIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & !A4;
187:
188:
189:/* Compact Flash 0xBFB0 - 0xBFBF */
190:CF_nCS  = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & A4;
191:CF_nRES = RESET;
192:
193:
194:/* Expansion Slot 0xBE00 - 0xBEFF*/
195:EXP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & !A8   &   !A7 & !A6 & !A5 & !A4;
196:
197:
198:/* ROM 0xC000 - 0xFFFF */
199:ROM_nR  = A15 & A14;   /* ROM Read address */
200:ROM_nCS = 'b'1;        /* ROM chip select always active */
201:
202:
203:/* RAM bank 0 0x0000 - 0x7FFF */                        
204:RAM_nCS0 = !A15;        
205:RW = PHI2 & !RnW;
206:RD = PHI2 & RnW;
207:
208:/* RAM bank 1 0x8000 - 0xBDFF */
209:RAM_nCS1 = A15 & !A14 & !FT_CS & !ACIA_nCS & !DISP_nCS & !VIA_nCS & !CF_nCS & !EXP_nCS;
210:
211:
212:/* system wide logic */
213:CLK_OUT = CLK;
214:LED = FT_CS;
215:

