113:/*********************************************************
114: *                        PINNODES                       *
115: *********************************************************/
116:
117:/* Clock Stretch nodes */
118:Pinnode  0  = Q1;
119:Pinnode  0  = Q2;
120:
121:
122:
123:
124:
125:/*********************************************************
126: *                     Clock Bits and bobs               *
127: *********************************************************/
128:
129:
130:/* Clock Stretching */
131:Q0.ck = CLK;
132:Q1.ck = CLK;
133:Q2.ck = CLK;
134:PHI2.ck = CLK;
135:
136:Q0.ar = RESET;
137:Q1.ar = RESET;
138:Q2.ar = RESET;
139:PHI2.ar = RESET;
140:
141:Q0.D = !PHI2
142:       # PHI2 & !Q0;
143:
144:Q1.D = !PHI2 & !SLOW0
145:       # PHI2 & !Q1 & Q0
146:       # PHI2 & Q1 & !Q0;
147:
148:Q2.D = !PHI2 & !SLOW1
149:       # PHI2 & Q2 & !Q1
150:       # PHI2 & Q2 & !Q0        
151:       # PHI2 & !Q2 & Q1 & Q0;
152:
153:PHI2.D = !PHI2
154:       # PHI2 & !Q2     
155:       # PHI2 & !Q1
156:       # PHI2 & !Q0     
157:       # !PHI2 & Q2 & Q1 & Q0;
158:
159:/*********************************************************
160: *                     Decode & glue                     *
161: *********************************************************/

