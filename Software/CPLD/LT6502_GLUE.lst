 54:/* Address bus all are INPUT */
 55:Pin 25 = A0;
 56:Pin 24 = A1;
 57:Pin 23 = A2;
 58:Pin 22 = A3;
 59:Pin 21 = A4;
 60:Pin 20 = A5;
 61:Pin 19 = A6;
 62:Pin 17 = A7;
 63:Pin 16 = A8;
 64:Pin 14 = A9;
 65:Pin 13 = A10;
 66:Pin 12 = A11;
 67:Pin 10 = A12;
 68:Pin  9 = A13;
 69:Pin  8 = A14;
 70:Pin  7 = A15;
 71:
 72:
 73:/* Data bus */
 74:Pin 60 = D0;
 75:Pin 58 = D1;
 76:Pin 57 = D2;
 77:Pin 56 = D3;
 78:Pin 55 = D4;
 79:Pin 54 = D5;
 80:Pin 53 = D6;
 81:Pin 52 = D7;
 82:
 83:
 84:
 85:/*********************************************************
 86: *                        PINNODES                       *
 87: *********************************************************/
 88:
 89:/* Clock Stretch nodes */
 90:Pinnode  0  = Q1;
 91:Pinnode  0  = Q2;
 92:
 93:/*********************************************************
 94: *                        VARIABLES                      *
 95: *********************************************************/
 96:
 97:
 98:
 99:
100:/*********************************************************
101: *                     LOGIC EQUATIONS                   *
102: *********************************************************/
103:
104:
105:/* Clock Stretching */
106:Q0.ck = CLK;
107:Q1.ck = CLK;

