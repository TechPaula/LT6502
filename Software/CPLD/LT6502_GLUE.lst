 54:Pin 76 = !VIA_nCS;
 55:
 56:
 57:/* Expansion card */
 58:Pin 78 = !EXP_nCS;
 59:
 60:
 61:/* Compact Flash */
 62:Pin 80 = !CF_nRES;       /* OUT, was nCS, but I swapped pins on the schematic, DOH! */
 63:Pin 81 = !CF_nCS;        /* OUT, was nRES, but I swapped pins on the schematic, DOH! */
 64:
 65:
 66:/* Keyboard Serial port, 65C51 */
 67:Pin 77 = !ACIA_nCS;
 68:
 69:
 70:/* Display */
 71:Pin 98 = !DISP_nCS;
 72:Pin 27 = DISP_DATA_EN;
 73:Pin  6 = DISP_BL;
 74:
 75:
 76:/* Address bus all are INPUT */
 77:Pin 25 = A0;
 78:Pin 24 = A1;
 79:Pin 23 = A2;
 80:Pin 22 = A3;
 81:Pin 21 = A4;
 82:Pin 20 = A5;
 83:Pin 19 = A6;
 84:Pin 17 = A7;
 85:Pin 16 = A8;
 86:Pin 14 = A9;
 87:Pin 13 = A10;
 88:Pin 12 = A11;
 89:Pin 10 = A12;
 90:Pin  9 = A13;
 91:Pin  8 = A14;
 92:Pin  7 = A15;
 93:
 94:
 95:/* Data bus */
 96:Pin 60 = D0;
 97:Pin 58 = D1;
 98:Pin 57 = D2;
 99:Pin 56 = D3;
100:Pin 55 = D4;
101:Pin 54 = D5;
102:Pin 53 = D6;
103:Pin 52 = D7;
104:
105:
106:
107:/*********************************************************

