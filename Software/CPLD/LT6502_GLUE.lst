216:ROM_nCS = 'b'1;        /* ROM chip select always active */
217:
218:
219:/* RAM bank 0 0x0000 - 0x7FFF */                        
220:RAM_nCS0 = !A15;        
221:RW = PHI2 & !RnW;
222:RD = PHI2 & RnW;
223:
224:
225:/* RAM bank 1 0x8000 - 0xBDFF */
226:RAM_nCS1 = A15 & !A14 & !FT_CS & !ACIA_nCS & !DISP_nCS & !VIA_nCS & !CF_nCS & !EXP_nCS & !BEEP_CS;
227:
228:
229:
230:
231:/* system wide logic */
232:CLK_OUT = CLK;
233:LED = CF_nCS;
234:
235:
236:
237:/* END OF FILE */
238:/*****************************************************/
