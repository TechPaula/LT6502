108: *                        PINNODES                       *
109: *********************************************************/
110:
111:/* Clock Stretch nodes */
112:Pinnode  0  = Q1;
113:Pinnode  0  = Q2;
114:
115:/*********************************************************
116: *                        VARIABLES                      *
117: *********************************************************/
118:
119:
120:
121:
122:/*********************************************************
123: *                     LOGIC EQUATIONS                   *
124: *********************************************************/
125:
126:
127:/* Clock Stretching */
128:Q0.ck = CLK;
129:Q1.ck = CLK;
130:Q2.ck = CLK;
131:PHI2.ck = CLK;
132:
133:Q0.ar = RESET;
134:Q1.ar = RESET;
135:Q2.ar = RESET;
136:PHI2.ar = RESET;
137:
138:Q0.D = !PHI2
139:       # PHI2 & !Q0;
140:
141:Q1.D = !PHI2 & !SLOW0
142:       # PHI2 & !Q1 & Q0
143:       # PHI2 & Q1 & !Q0;
144:
145:Q2.D = !PHI2 & !SLOW1
146:       # PHI2 & Q2 & !Q1
147:       # PHI2 & Q2 & !Q0        
148:       # PHI2 & !Q2 & Q1 & Q0;
149:
150:PHI2.D = !PHI2
151:       # PHI2 & !Q2     
152:       # PHI2 & !Q1
153:       # PHI2 & !Q0     
154:       # !PHI2 & Q2 & Q1 & Q0;
155:
156:
157:
158:/* FT245 Serial port 0xBFF0 - 0xBFFF */                 
159:FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;
160:
161:RD_FT = PHI2 & FT_CS & A0 &  RnW;               /* 0xBFF1 */

LISTING FOR LOGIC DESCRIPTION FILE: LT6502_GLUE.pld                  Page 4

CUPL(WM): Universal Compiler for Programmable Logic
Version 5.0a Serial# 60008009
