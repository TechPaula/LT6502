 54:Pin 76 = !VIA_nCS;
 55:
 56:
 57:/* Expansion card */
 58:Pin 78 = !EXP_nCS;
 59:
 60:
 61:/* Compact Flash */
 62:Pin 80 = !CF_nRES;       /* OUT, was nCS, but I swapped pins on the schematic, DOH! */
 63:Pin 81 = !CF_nCS;        /* OUT, was nRES, but I swapped pins on the schematic, DOH! */
 64:
 65:
 66:/* Keyboard Serial port, 65C51 */
 67:Pin 77 = !ACIA_nCS;
 68:
 69:
 70:/* Display */
 71:Pin 98 = !DISP_nCS;
 72:Pin 27 = DISP_DATA_EN;    /* OUT, databus level shifter enable */
 73:Pin  6 = DISP_BL;
 74:Pin 99 = !DISP_nRES;
 75:Pin 100 = DISP_E;         /* OUT, 6800 "E" signal
 76:
 77:
 78:/* Beeper */
 79:Pin 92 = BEEPER;
 80:
 81:
 82:/* Address bus all are INPUT */
 83:Pin 25 = A0;
 84:Pin 24 = A1;
 85:Pin 23 = A2;
 86:Pin 22 = A3;
 87:Pin 21 = A4;
 88:Pin 20 = A5;
 89:Pin 19 = A6;
 90:Pin 17 = A7;
 91:Pin 16 = A8;
 92:Pin 14 = A9;
 93:Pin 13 = A10;
 94:Pin 12 = A11;
 95:Pin 10 = A12;
 96:Pin  9 = A13;
 97:Pin  8 = A14;
 98:Pin  7 = A15;
 99:
100:
101:/* Data bus */
102:Pin 60 = D0;
103:Pin 58 = D1;
104:Pin 57 = D2;
105:Pin 56 = D3;
106:Pin 55 = D4;
107:Pin 54 = D5;

