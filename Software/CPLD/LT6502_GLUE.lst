162:
163:
164:/* FT245 Serial port 0xBFF0 - 0xBFFF */                 
165:FT_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & A4;
166:
167:RD_FT = PHI2 & FT_CS & A0 &  RnW;               /* 0xBFF1 */
168:WR_FT = PHI2 & FT_CS & A0 & !RnW;               /* 0xBFF1 */ 
169:
170:D0.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
171:
172:D1.oe = FT_CS & !A0 & RnW;                      /* 0xBFF0 */
173:
174:D0 = !RXF;                              
175:D1 = !TXE;                      
176:
177:
178:/* Keyboard ACIA - 0xBFE0 - 0xBFEF */
179:ACIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & A5 & !A4;
180: 
181:/* Display 0xBFD0 - 0xBFDF */
182:DISP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & A4;
183:DISP_DATA_EN = DISP_nCS;
184:DISP_E = DISP_nCS & Q0;
185:DISP_BL = 'b'1;
186:DISP_nRES = RESET;
187:
188:
189:/* Onboard VIA 65c22 0xBFC0 - 0xBFCF */
190:VIA_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & A6 & !A5 & !A4;
191:
192:
193:/* Compact Flash 0xBFB0 - 0xBFBF */
194:CF_nCS  = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & A4;
195:CF_nRES = RESET;
196:
197:
198:/* Beeper, a simple SR latch for now - 0xBFA0 - 0xBFAF */
199:BEEP_CS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & A8   &   A7 & !A6 & A5 & !A4;
200:BEEP_S = D2 & BEEP_CS;
201:BEEP_R = !D2 & BEEP_CS;
202:BEEPER =  (BEEPER & !BEEP_R) # BEEP_S;
203:
204:
205:/* Expansion Slot 0xBE00 - 0xBEFF*/
206:EXP_nCS = A15 & !A14 & A13 & A12   &   A11 & A10 & A9 & !A8;
207:
208:
209:/***********************/
210:/* GAP 0xBFF0 - 0xBFCF */
211:/***********************/
212:
213:
214:/* ROM 0xC000 - 0xFFFF */
215:ROM_nR  = A15 & A14;   /* ROM Read address */

