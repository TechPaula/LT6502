216:
217:
218:/* RAM bank 0 0x0000 - 0x7FFF */                        
219:RAM_nCS0 = !A15;        
220:RW = PHI2 & !RnW & !FT_CS ;
221:RD = PHI2 &  RnW & !FT_CS;
222:
223:
224:/* RAM bank 1 0x8000 - 0xBDFF */
225:RAM_nCS1 = A15 & !A14 & !FT_CS & !ACIA_nCS & !DISP_nCS & !VIA_nCS & !CF_nCS & !EXP_nCS & !BEEP_CS;
226:
227:
228:
229:
230:/* system wide logic */
231:CLK_OUT = CLK;
232:LED = CF_nCS;
233:
234:
235:
236:/* END OF FILE */
