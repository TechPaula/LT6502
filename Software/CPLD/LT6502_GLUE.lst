 10:
 11:/*********************************************************
 12: *                     INPUT PINS                        *
 13: *********************************************************/
 14:
 15:
 16:/* SYSTEM signals */
 17:Pin 87 = CLK;       /* MAIN OSC CLOCK IN */
 18:Pin 93 = !RESET;    /* GLOBAL RESET IN */
 19:Pin 84 = CLK_OUT;   /* Sent to expansion header, WAS Q0 but VIA/ACIA connected to pin 83, oops */
 20:Pin 83 = Q0;        /* sent to expansion header OUT, NOW CLK/2, same speed as CPU unstretched */
 21:
 22:Pin 96 = !SLOW0;    /* CPU Clock Slow bit 0, INPUT */
 23:Pin 97 = !SLOW1;    /* CPU Clock Slow bit 1, INPUT */
 24:
 25:Pin 37 = !RD;       /* OUTPUT */
 26:Pin 36 = !RW;       /* OUTPUT */
 27:
 28:Pin 94 = !LED;      /* Test LED output */
 29:
 30:
 31:/* CPU signals */
 32:Pin 75 = PHI2;      /* CPU_CLK OUTPUT */
 33:Pin 90 = RnW;       /* INPUT */
 34:
 35:
 36:/* ROM Enables */
 37:Pin 45 = !ROM_nR;    /* OUTPUT */
 38:Pin 46 = !ROM_nCS;   /* OUTPUT */
 39:
 40:
 41:/* RAM CS */
 42:Pin 42 = !RAM_nCS0;    /* OUTPUT */
 43:Pin 40 = !RAM_nCS1;    /* OUTPUT */
 44:
 45:
 46:/* FT245, Console, Signals */
 47:Pin 48 = !RD_FT;           /* OUTPUT */
 48:Pin 47 = WR_FT;            /* OUTPUT */
 49:Pin 49 = RXF;                /* BIT 0 of 6850 register, INPUT */
 50:Pin 50 = TXE;                /* BIT 1 of 6850 register, INPUT */
 51:                           /* Had to swap pin 49/50, Labels swapped on schematic, DOH! */
 52:
 53:/* 65C22 VIA */

