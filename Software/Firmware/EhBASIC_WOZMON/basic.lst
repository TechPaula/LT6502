00F338  1               
00F338  1  20 6A F3     	JSR	ACIAout			; output character
00F33B  1               
00F33B  1  29 DF        	AND	#$DF			; mask xx0x xxxx, ensure upper case
00F33D  1  C9 57        	CMP	#'W'			; compare with [W]arm start
00F33F  1  F0 13        	BEQ	LAB_dowarm		; branch if [W]arm start
00F341  1               
00F341  1  C9 4D            CMP #'M'
00F343  1  F0 1A            BEQ LAB_dowoz
00F345  1               
00F345  1  C9 43        	CMP	#'C'			; compare with [C]old start
00F347  1  D0 B7        	BNE RES_vec
00F349  1               
00F349  1  A9 0D        	LDA #$0D
00F34B  1  8D E0 BF     	STA A_txd			; clear keyboard screen
00F34E  1  20 BF F3     	JSR KYB_basmsg
00F351  1  4C 00 C0     	JMP	LAB_COLD		; do EhBASIC cold start
00F354  1               
00F354  1               LAB_dowarm
