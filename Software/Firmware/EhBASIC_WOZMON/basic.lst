00F396  1               
00F396  1  68           	PLA
00F397  1  60           	RTS
00F398  1               
00F398  1               LAB_WAIT_Rx
00F398  1  AD E1 BF         LDA A_sts       ; get ACIA status
00F39B  1  29 08            AND #$08        ; mask rx buffer status flag
00F39D  1  F0 F9            BEQ LAB_WAIT_Rx ; loop if rx buffer empty
00F39F  1               
00F39F  1  AD E0 BF         LDA A_rxd       ; get byte from ACIA data port
00F3A2  1               
00F3A2  1               
00F3A2  1               ; byte in from simulated ACIA (CONSOLE) or Keyboard
00F3A2  1               ACIAin
00F3A2  1  AD F0 BF     	LDA	ACIAStatus
00F3A5  1  29 01        	AND	#1
00F3A7  1  C9 01        	CMP	#1
00F3A9  1  D0 05        	BNE	NoDataIn
00F3AB  1  AD F1 BF     	LDA	ACIAData
00F3AE  1  38           	SEC		; Carry set if key available
00F3AF  1  60           	RTS
00F3B0  1               NoDataIn:	; nothing from console port
00F3B0  1  18           	CLC		; Carry clear if no key pressed
00F3B1  1               
00F3B1  1               KEY_RX		; we get here if there is no data from console
00F3B1  1  AD E1 BF         LDA A_sts       ; get ACIA status
00F3B4  1  29 08            AND #$08        ; mask rx buffer status flag
00F3B6  1  F0 05            BEQ KEYB_NoData ; skip if rx buffer empty
00F3B8  1               
00F3B8  1  AD E0 BF         LDA A_rxd       ; get byte from ACIA data port
00F3BB  1  38           	SEC				; Carry set if key available
00F3BC  1  60           	RTS
00F3BD  1               
00F3BD  1               KEYB_NoData
00F3BD  1  18           	CLC				; Carry clear if no key pressed
00F3BE  1  60           	RTS
00F3BF  1               
00F3BF  1               
