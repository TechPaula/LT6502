00F6CA  1  A9 59        	lda #$59          ; MSB of X coordinate
00F6CC  1  A0 00        	ldy #0
00F6CE  1  20 75 F6     	jsr DISP_writereg
00F6D1  1  A9 5A        	lda #$5A          ; LSB of Y coordinate
00F6D3  1  A0 00        	ldy #0
00F6D5  1  20 75 F6     	jsr DISP_writereg
00F6D8  1  A9 5B        	lda #$5B          ; MSB of Y coordinate
00F6DA  1  A0 00        	ldy #0
00F6DC  1  20 75 F6     	jsr DISP_writereg
00F6DF  1               
