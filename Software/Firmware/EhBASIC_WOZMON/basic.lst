00FB2C  1  16 03 17 03  	.byte	$16,$03,$17,$03,$18,$0B,$19,$DF,$1A,$01,$1B,$1F,$1C,$00,$1D,$16
00FB30  1  18 0B 19 DF  
00FB34  1  1A 01 1B 1F  
00FB3C  1  1E 00 1F 01  	.byte	$1E,$00,$1F,$01,$30,$00,$31,$00,$34,$1F,$35,$03,$32,$00,$33,$00
00FB40  1  30 00 31 00  
00FB44  1  34 1F 35 03  
00FB4C  1  36 DF 37 01  	.byte	$36,$DF,$37,$01,$01,$80,$C7,$01
00FB50  1  01 80 C7 01  
