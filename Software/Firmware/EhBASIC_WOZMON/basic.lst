00F97F  1               ; save string to buffer
00F97F  1  20 49 D3     	JSR LAB_22B6        ; pop string off descriptor stack, or from top of string
00F982  1               						; space returns with A = length, X=$71=pointer low byte,
00F982  1               						; Y=$72=pointer high byte
00F982  1  A0 00        	LDY #$00           	; reset index
00F984  1  AA           	TAX                 ; copy length to X
00F985  1               
00F985  1               IO_SAVE_stringloop
00F985  1  B1 71        	LDA (ut1_pl),Y     		; get next byte
00F987  1  99 00 04     	STA $0400,Y          	; Put char into buffer
00F98A  1  C8           	INY                     ; increment index
00F98B  1               
00F98B  1  98           	TYA
00F98C  1  C9 10        	CMP #$10
00F98E  1  F0 11        	BEQ IO_SAVE_createinfo	; break if more than 16 characters long
00F990  1               
00F990  1  CA           	DEX                     ; decrement count
00F991  1  D0 F2        	BNE IO_SAVE_stringloop 	; loop if not done yet
00F993  1               
00F993  1               	; PAD OUT REST WITH SPACES
00F993  1               IO_SAVE_pad
00F993  1  A9 20        	LDA #$20	     		; get next byte
00F995  1  99 00 04     	STA $0400,Y          	; Put char into buffer
00F998  1  C8           	INY                     ; increment index
00F999  1  98           	TYA
00F99A  1  C9 10        	CMP #$10
00F99C  1  F0 03        	BEQ IO_SAVE_createinfo	; break if more than 16 characters long
00F99E  1  CA           	DEX                     ; decrement count
00F99F  1  D0 F2        	BNE IO_SAVE_pad 	; loop if not done yet
00F9A1  1               
00F9A1  1               
00F9A1  1               IO_SAVE_createinfo
00F9A1  1               ;  CREATE "INFO" SECTOR (FIRST SECTOR OF BLOCK)
00F9A1  1  A5 7A        	LDA Smemh
00F9A3  1  8D 10 04     	STA $0410
00F9A6  1  A5 79        	LDA Smeml
00F9A8  1  8D 11 04     	STA $0411
00F9AB  1  A5 7C        	LDA Svarh
00F9AD  1  8D 12 04     	STA $0412
00F9B0  1  A5 7B        	LDA Svarl
00F9B2  1  8D 13 04     	STA $0413
00F9B5  1               
00F9B5  1  A9 04        	LDA #$04			; Set START (basic)
00F9B7  1  85 41        	STA BUFPTRH
00F9B9  1  A9 00        	LDA #$00
00F9BB  1  85 40        	STA BUFPTRL
00F9BD  1               
00F9BD  1  20 E8 F9     	JSR CF_INIT
00F9C0  1  20 59 FA     	JSR CF_WRITE_SECTOR
00F9C3  1  20 E2 F9     	JSR IO_LOAD_SAVE_incrlba
00F9C6  1               
00F9C6  1               	; SAVE ACTUAL BASIC CODE
00F9C6  1  A9 08        	LDA #$08			; Set START (basic)
00F9C8  1  85 41        	STA BUFPTRH
00F9CA  1  A9 00        	LDA #$00
00F9CC  1  85 40        	STA BUFPTRL
00F9CE  1               
00F9CE  1               IO_SAVE_loop			; ! HACKY, JUST DUMP ALL 46K OF RAM TO CF CARD
00F9CE  1  20 59 FA     	JSR CF_WRITE_SECTOR
00F9D1  1               
00F9D1  1  20 E2 F9     	JSR IO_LOAD_SAVE_incrlba
00F9D4  1  A5 41        	LDA BUFPTRH
00F9D6  1  C9 BE        	CMP #$BE
00F9D8  1               ;	CMP Svarh			; TODO - IS THIS A BETTER WAY TO DO IT???
00F9D8  1  D0 F4        	BNE IO_SAVE_loop
00F9DA  1               
00F9DA  1               IO_SAVE_exit
00F9DA  1  60           	RTS
00F9DB  1               
00F9DB  1               
00F9DB  1               ; empty DIR vector for EhBASIC
00F9DB  1               IO_DIR
00F9DB  1  20 E8 F9     	JSR CF_INIT
00F9DE  1  20 35 F8     	JSR PWR_BEEP_HIGH
00F9E1  1  60           	RTS
00F9E2  1               
00F9E2  1               
00F9E2  1               IO_LOAD_SAVE_incrlba
00F9E2  1  A5 42        	LDA LBA_0
00F9E4  1  1A           	INC
00F9E5  1  85 42        	STA LBA_0
00F9E7  1               
00F9E7  1  60           	RTS
00F9E8  1               
00F9E8  1               
00F9E8  1               ;-------------------------------------------------------------------------------
00F9E8  1               ; CF_INIT - Set 8 bit mode, write 1 to feature register
00F9E8  1               ;			then $EF to command register to execute
00F9E8  1               ;-------------------------------------------------------------------------------
00F9E8  1               CF_INIT:
00F9E8  1  5A               PHY
00F9E9  1  DA               PHX
00F9EA  1  48               PHA
00F9EB  1  20 FC F9         JSR     CF_WAIT
00F9EE  1  A9 01            LDA     #$01
00F9F0  1  8D B1 BF         STA     CF_FEATURE
00F9F3  1  A9 EF            LDA     #CMD_FEATURE
00F9F5  1  8D B7 BF         STA     CF_COMMAND
00F9F8  1  68               PLA
00F9F9  1  FA               PLX
00F9FA  1  7A               PLY
00F9FB  1  60               RTS
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               
00F9FC  1               ;-------------------------------------------------------------------------------
00F9FC  1               ; CF_WAIT - Checks the CF card isn't busy
00F9FC  1               ;
00F9FC  1               ; Wait for flag MSB of status register to be clear
00F9FC  1               ;
00F9FC  1               ; TODO - Implement time out?
00F9FC  1               ;
00F9FC  1               ;-------------------------------------------------------------------------------
00F9FC  1               CF_WAIT:
00F9FC  1  AD B7 BF         LDA     CF_STATUS
00F9FF  1  30 FB            BMI     CF_WAIT
00FA01  1  60               RTS
00FA02  1               
00FA02  1               
00FA02  1               
00FA02  1               ;-------------------------------------------------------------------------------
00FA02  1               ; CF_SET_LBA - Sets up the CF Card with LBA and Sector Count parameters
00FA02  1               ;
00FA02  1               ; LBA values are read from Zero Page at $42(LBA0) to $45(LBA3)
00FA02  1               ;
00FA02  1               ; Sector count is always 1
00FA02  1               ;
00FA02  1               ;-------------------------------------------------------------------------------
00FA02  1               CF_SET_LBA:
00FA02  1  20 FC F9         JSR     CF_WAIT
00FA05  1               
00FA05  1                   ; SET ONE SECTOR (512 BYTES) AT A TIME
00FA05  1  A9 01            LDA     #$01
00FA07  1  8D B2 BF         STA     CF_SEC_CNT
00FA0A  1  20 FC F9         JSR     CF_WAIT
00FA0D  1               
00FA0D  1               
00FA0D  1  A5 42            LDA     LBA_0           ; Lower Byte
00FA0F  1  8D B3 BF         STA     CF_LBA0
00FA12  1  20 FC F9         JSR     CF_WAIT
00FA15  1               
00FA15  1  A5 43            LDA     LBA_1           ; Lower Middle Byte
00FA17  1  8D B4 BF         STA     CF_LBA1
00FA1A  1  20 FC F9         JSR     CF_WAIT
00FA1D  1               
00FA1D  1  A5 44            LDA     LBA_2           ; Upper Middle Byte
00FA1F  1  8D B5 BF         STA     CF_LBA2
00FA22  1  20 FC F9         JSR     CF_WAIT
00FA25  1               
00FA25  1  A5 45            LDA     LBA_3           ; Upper Nybble
00FA27  1  29 0F            AND     #$0F            ; Ensure top 4 bits are 0000
00FA29  1  09 E0            ORA     #$E0            ; Then force top 4 bits to 1110
00FA2B  1  8D B6 BF         STA     CF_LBA3
00FA2E  1  20 FC F9         JSR     CF_WAIT
00FA31  1  60               RTS
00FA32  1               
00FA32  1               
00FA32  1               ;-------------------------------------------------------------------------------
00FA32  1               ; CF_READ_SECTOR - Reads a single sector from CF into a buffer
00FA32  1               ;
00FA32  1               ; Buffer address should always be page aligned. Set BUFPTRL to 0, and
00FA32  1               ; BUFPTRH to high byte of buffer address
00FA32  1               ; Set number of memory pages to use for buffer in PAGES, default = 2
00FA32  1               ;
00FA32  1               ;-------------------------------------------------------------------------------
00FA32  1               CF_READ_SECTOR:
00FA32  1  20 02 FA         JSR     CF_SET_LBA
00FA35  1  20 FC F9         JSR     CF_WAIT
00FA38  1               
00FA38  1  A9 20            LDA     #CMD_READ           ; Send the Read command to the CF
00FA3A  1  8D B7 BF         STA     CF_COMMAND
00FA3D  1  20 FC F9         JSR     CF_WAIT             ; de dum de dum
00FA40  1               
00FA40  1  A9 02            LDA     #$02                ; Set page count to 2
00FA42  1  85 46            STA     PAGES
00FA44  1               
00FA44  1  A0 00            LDY     #$00                ; Clear Y
00FA46  1               
00FA46  1               CF_RD_LP1:
00FA46  1  AD B0 BF         LDA     CF_DATA             ; Read CF Data Register
00FA49  1  91 40            STA     (BUFPTRL),Y         ; Save to buffer
00FA4B  1               
00FA4B  1  C8               INY                         ; Increment buffer pointer
00FA4C  1  D0 F8            BNE     CF_RD_LP1           ; If it's zero, we need a new page, otherwise repeat
00FA4E  1               
00FA4E  1  E6 41            INC     BUFPTRH             ; Increment the high byte of the buffer pointer
00FA50  1                                               ; (So subsequent reads don't need to set up pointer)
00FA50  1               
00FA50  1  C6 46            DEC     PAGES               ; decrement page counter
00FA52  1  F0 04            BEQ     CF_RD_EXIT          ; if it's zero, we're done, so exit
00FA54  1               
00FA54  1  A0 00            LDY     #$00                ; Clear Y (it should be already, but JFDI)
00FA56  1  80 EE            BRA     CF_RD_LP1           ; and repeat for another 256 bytes
00FA58  1               
00FA58  1               CF_RD_EXIT:
00FA58  1  60               RTS
00FA59  1               
00FA59  1               ;-------------------------------------------------------------------------------
00FA59  1               ; CF_WRITE_SECTOR - writes a single sector from buffer into a CF
00FA59  1               ;
00FA59  1               ; Buffer address should always be page aligned. Set BUFPTRL to 0, and
00FA59  1               ; BUFPTRH to high byte of buffer address
00FA59  1               ; Set number of memory pages to use for buffer in PAGES, default = 2
00FA59  1               ;-------------------------------------------------------------------------------
00FA59  1               CF_WRITE_SECTOR:
00FA59  1  20 02 FA         JSR     CF_SET_LBA
00FA5C  1  20 FC F9         JSR     CF_WAIT
00FA5F  1               
00FA5F  1  A9 30            LDA     #CMD_WRITE          ; Send the Read command to the CF
00FA61  1  8D B7 BF         STA     CF_COMMAND
00FA64  1  20 FC F9         JSR     CF_WAIT             ; de dum de dum;
00FA67  1               
00FA67  1  A9 02            LDA     #$02                ; Set page count to 2
00FA69  1  85 46            STA     PAGES
00FA6B  1               
00FA6B  1  A0 00            LDY     #$00                ; Clear Y
00FA6D  1               
00FA6D  1               CF_WR_LP1:
00FA6D  1  B1 40            LDA     (BUFPTRL),Y         ; Read from buffer
00FA6F  1  8D B0 BF         STA     CF_DATA             ; Write to CF Data Register
00FA72  1               
00FA72  1  C8               INY                         ; Increment buffer pointer
00FA73  1  D0 F8            BNE     CF_WR_LP1           ; If it's zero, we need a new page, otherwise repeat
00FA75  1               
00FA75  1  E6 41            INC     BUFPTRH             ; Increment the high byte of the buffer pointer
00FA77  1                                               ; (So subsequent writes don't need to set pointer)
00FA77  1               
00FA77  1  C6 46            DEC     PAGES               ; decrement page counter
00FA79  1  F0 04            BEQ     CF_WR_EXIT          ; if it's zero, we're done, so exit
00FA7B  1               
00FA7B  1               
00FA7B  1  A0 00            LDY     #$00                ; Clear Y (it should be already, but JFDI)
00FA7D  1  80 EE            BRA     CF_WR_LP1           ; and repeat for another 256 bytes
00FA7F  1               
00FA7F  1               CF_WR_EXIT:
00FA7F  1  60               RTS
00FA80  1               
00FA80  1               ;-------------------------------------------------------------------------------
00FA80  1               ; CLR_CFBUFFER - Clears the Compact Flash read/write buffer
00FA80  1               ;
00FA80  1               ; Buffer address should always be page aligned. Set BUFPTRL to 0, and
00FA80  1               ; BUFPTRH to high byte of buffer address
00FA80  1               ; Set number of memory pages to clear in PAGES
00FA80  1               ;
00FA80  1               ;-------------------------------------------------------------------------------
00FA80  1                CLR_CFBUFFER:
00FA80  1               
00FA80  1  A0 00            LDY     #$00            ; Set offset to 0
00FA82  1               
00FA82  1  A9 00            LDA     #$00            ; Value to write
00FA84  1               CLRLOOP:
00FA84  1  91 40            STA     (BUFPTR),Y      ; Write data to memory
00FA86  1  C8               INY                     ; Point to next byte
00FA87  1  D0 FB            BNE     CLRLOOP         ; do it 256 times
00FA89  1               
00FA89  1  C6 46            DEC     PAGES           ; Check if all done
00FA8B  1  F0 06            BEQ     CLRDONE         ; if so, exit
00FA8D  1               
00FA8D  1  A0 00            LDY     #$00            ; if not, clear offset again
00FA8F  1  E6 41            INC     BUFPTRH         ; Increment page counter
00FA91  1  80 F1            BRA     CLRLOOP         ; and repeat
00FA93  1               CLRDONE:
00FA93  1  60               RTS
00FA94  1               
00FA94  1               
00FA94  1               
00FA94  1               
00FA94  1               
00FA94  1               
00FA94  1               ; ------ END compact flash
00FA94  1               
00FA94  1               
00FA94  1               ; ----- OUTK send text to keyboard display
00FA94  1               ;			we always print to the next character, don't need ; or ,
00FA94  1               ;			CRLF is not auto sent
00FA94  1               OUTK
00FA94  1  5A           	PHY
00FA95  1  DA           	PHX
00FA96  1  48           	PHA
00FA97  1               
00FA97  1               	; send result to keyboard
00FA97  1  20 D8 CA         JSR LAB_EVEX        ; evaluate expression
00FA9A  1  24 5F            BIT Dtypef          ; test data type flag, $FF=string, $00=numeric
00FA9C  1  30 1B            BMI OUTK_string     ; branch if string
00FA9E  1  20 99 DA     	JSR LAB_296E        ; convert FAC1 to string
00FAA1  1               
00FAA1  1  A0 00        	LDY #$00			; Reset offset
00FAA3  1               OUTK_lp
00FAA3  1  B9 F0 00     	LDA $00F0,Y			; Read string
00FAA6  1  C9 00        	CMP #$00
00FAA8  1  F0 0B        	BEQ OUTK_exit		; if end of string, exit
00FAAA  1  C9 20        	CMP #$20
00FAAC  1  F0 03        	BEQ OUTK_skip		; if " " then skip
00FAAE  1  20 BD F3     	JSR KEYBout			; send character
00FAB1  1               
00FAB1  1               OUTK_skip
00FAB1  1  C8           	INY
00FAB2  1  4C A3 FA     	JMP OUTK_lp
00FAB5  1               
00FAB5  1               OUTK_exit
00FAB5  1  68           	PLA
00FAB6  1  FA           	PLX
00FAB7  1  7A           	PLY
00FAB8  1  60           	RTS
00FAB9  1               
00FAB9  1               OUTK_string
00FAB9  1  A9 0D        	LDA #$0D				; Clear the display BEFORE sending text
00FABB  1  20 BD F3     	JSR KEYBout
00FABE  1               
00FABE  1  20 49 D3     	JSR LAB_22B6        ; pop string off descriptor stack, or from top of string
00FAC1  1               						; space returns with A = length, X=$71=pointer low byte,
00FAC1  1               						; Y=$72=pointer high byte
00FAC1  1  A0 00        	LDY #$00           	; reset index
00FAC3  1  AA           	TAX                 ; copy length to X
00FAC4  1  F0 EF        	BEQ OUTK_exit       ; exit (RTS) if null string
00FAC6  1               
00FAC6  1               OUTK_string_loop
00FAC6  1  B1 71        	LDA (ut1_pl),Y     		; get next byte
00FAC8  1  20 BD F3     	JSR KEYBout          	; go print the character
00FACB  1  C8           	INY                     ; increment index
00FACC  1  CA           	DEX                     ; decrement count
00FACD  1  D0 F7        	BNE OUTK_string_loop  	; loop if not done yet
00FACF  1               
00FACF  1  4C B5 FA     	JMP OUTK_exit
00FAD2  1               ; ----- END OF OUTK
00FAD2  1               
00FAD2  1               
00FAD2  1               ; Delay loop for random things
00FAD2  1               DELAY1
00FAD2  1  A9 05        	LDA #DELAY_LEN1
00FAD4  1  8D 12 06     	STA MyDL3
00FAD7  1               
00FAD7  1               DELAY1_LP
00FAD7  1  CE 12 06     	DEC MyDL3
00FADA  1  D0 FB        	BNE DELAY1_LP
00FADC  1               
00FADC  1  60           	RTS
00FADD  1               
00FADD  1               DELAY2
00FADD  1  A9 05        	LDA #DELAY_LEN1
00FADF  1  8D 12 06     	STA MyDL3
00FAE2  1               
00FAE2  1               DELAY2_LP
00FAE2  1  EA           	NOP
00FAE3  1  EA           	NOP
00FAE4  1  EA           	NOP
00FAE5  1  EA           	NOP
00FAE6  1  CE 12 06     	DEC MyDL3
00FAE9  1  D0 EC        	BNE DELAY1_LP
00FAEB  1               
00FAEB  1  60           	RTS
