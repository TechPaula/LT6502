00F381  1  48           	PHA					; save A
00F382  1               
00F382  1  A9 FF        	LDA #$FF
00F384  1  8D 10 06     	STA MyDL
00F387  1               KEYDL				; Outer loop
00F387  1  A9 40        	LDA #$40
00F389  1  8D 11 06     	STA MyDL2
00F38C  1               KEYDL2				; Inner loop
00F38C  1  CE 11 06     	DEC MyDL2
00F38F  1  D0 FB        	BNE	KEYDL2
00F391  1               
00F391  1  CE 10 06     	DEC MyDL
