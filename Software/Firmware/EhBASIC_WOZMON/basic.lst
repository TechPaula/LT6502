00E09C  2  E5 5B              SBC   Temp3             ; subtract partial low byte
00E09E  2  85 5B              STA   Temp3             ; save partial low byte
00E0A0  2               
00E0A0  2  A5 76              LDA   FACt_2            ; get remainder low mid byte
00E0A2  2  E5 5C              SBC   Temp3+1           ; subtract partial low mid byte
00E0A4  2  85 5C              STA   Temp3+1           ; save partial low mid byte
00E0A6  2               
00E0A6  2  A5 75              LDA   FACt_1            ; get remainder high mid byte
00E0A8  2  E5 5D              SBC   Temp3+2           ; subtract partial high mid byte
00E0AA  2  A8                 TAY                     ; copy partial high mid byte
00E0AB  2               
00E0AB  2  A5 78              LDA   TempB             ; get remainder high byte
00E0AD  2  E5 5E              SBC   Temp3+3           ; subtract partial high byte
00E0AF  2  90 0E              BCC   LAB_SQNS          ; skip sub if remainder smaller
00E0B1  2               
00E0B1  2  85 78              STA   TempB             ; save remainder high byte
00E0B3  2               
00E0B3  2  84 75              STY   FACt_1            ; save remainder high mid byte
00E0B5  2               
00E0B5  2  A5 5C              LDA   Temp3+1           ; get remainder low mid byte
00E0B7  2  85 76              STA   FACt_2            ; save remainder low mid byte
00E0B9  2               
00E0B9  2  A5 5B              LDA   Temp3             ; get partial low byte
00E0BB  2  85 77              STA   FACt_3            ; save remainder low byte
00E0BD  2               
00E0BD  2  E6 AF              INC   FAC1_3            ; increment root low byte (never any rollover)
00E0BF  2               LAB_SQNS
00E0BF  2  CA                 DEX                     ; decrement bit pair count
00E0C0  2  D0 A2              BNE   LAB_SQE1          ; loop if not all done
00E0C2  2               
00E0C2  2  38                 SEC                     ; set carry for subtract
00E0C3  2  A5 B3              LDA   FAC2_e            ; get exponent
00E0C5  2  E9 80              SBC   #$80              ; normalise
00E0C7  2  6A                 ROR                     ; /2 and re-bias to $80
00E0C8  2  69 00              ADC   #$00              ; add bit zero back in (allow for half shift)
00E0CA  2  85 AC              STA   FAC1_e            ; save it
00E0CC  2  4C 38 D6           JMP   LAB_24D5          ; normalise FAC1 and return
00E0CF  2               
00E0CF  2               ; perform VARPTR()
00E0CF  2               
00E0CF  2               LAB_VARPTR
00E0CF  2  20 BC 00           JSR   LAB_IGBY          ; increment and scan memory
00E0D2  2  20 AF CD           JSR   LAB_GVAR          ; get var address
00E0D5  2  20 E6 CB           JSR   LAB_1BFB          ; scan for ")" , else do syntax error then warm start
00E0D8  2  A4 95              LDY   Cvaral            ; get var address low byte
00E0DA  2  A5 96              LDA   Cvarah            ; get var address high byte
00E0DC  2  4C 5E D0           JMP   LAB_AYFC          ; save and convert integer AY to FAC1 and return
00E0DF  2               
00E0DF  2               ; perform PI
00E0DF  2               
00E0DF  2               LAB_PI
00E0DF  2  A9 DF              LDA   #<LAB_2C7C        ; set (2*pi) pointer low byte
00E0E1  2  A0 E1              LDY   #>LAB_2C7C        ; set (2*pi) pointer high byte
00E0E3  2  20 81 D8           JSR   LAB_UFAC          ; unpack memory (AY) into FAC1
00E0E6  2  C6 AC              DEC   FAC1_e            ; make result = PI
00E0E8  2  60                 RTS
00E0E9  2               
00E0E9  2               ; perform TWOPI
00E0E9  2               
00E0E9  2               LAB_TWOPI
