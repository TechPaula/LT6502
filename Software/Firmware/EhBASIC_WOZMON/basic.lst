00F6FB  1               
00F6FB  1               	;; set BTE function
00F6FB  1               	;; function is "move in a positive direction". The "positive direction"
00F6FB  1               	;; means that we start at the beginning and move toward the end; since
00F6FB  1               	;; the source and destination regions overlap, that's what we need.
00F6FB  1               	;; ROP is "destionation = source" (ie, straight copy).
00F6FB  1               	;; ROP is %1100 = $C, ROP is %0010 = $02
00F6FB  1               	;; result is $C2
00F6FB  1  A9 51        	lda #$51
00F6FD  1  A0 C2        	ldy #$C2
