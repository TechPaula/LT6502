00F36A  1               ; byte out to simulated ACIA
00F36A  1               ACIAout
00F36A  1  48           	PHA
00F36B  1               SWait:
00F36B  1  AD F0 BF     	LDA	ACIAStatus
00F36E  1  29 02        	AND	#2
00F370  1  C9 02        	CMP	#2
00F372  1  D0 F7        	BNE	SWait
00F374  1  68           	PLA
00F375  1  8D F1 BF     	STA	ACIAData
00F378  1               
00F378  1               ; When screen is working insert screen text output code here
