00FAEC  1               ; vector tables
00FAEC  1               LAB_vec
00FAEC  1  E1 F3        	.word	ACIAin		; byte in from simulated ACIA  	EhBASIC = V_INPT
00FAEE  1  A9 F3        	.word	ACIAout		; byte out to simulated ACIA   	EhBASIC = V_OUTP
00FAF0  1  AA F8        	.word	IO_LOAD		; load vector for EhBASIC		EhBASIC = V_LOAD
00FAF2  1  4C F9        	.word	IO_SAVE		; save vector for EhBASIC		EhBASIC = V_SAVE
00FAF4  1  DB F9        	.word   IO_DIR		; dir vector for EhBASIC		EhBASIC = V_DIR
00FAF6  1  20 F8        	.word 	IO_CLS		; CLS vector for EhBASIC		EhBASIC = V_CLS
00FAF8  1  2E F6        	.word	IO_MODE		; MODE vector for EhBASIC		EhBASIC = V_MODE
00FAFA  1  24 F8        	.word   BEEP_CMD	; BEEP vector for EhBASIC		EhBASIC = V_BEEP
00FAFC  1  00 F0        	.word	EWOZ		; WOZMON vector					EhBASIC = V_WOZMON
00FAFE  1  62 F5        	.word	DISP_TEXT_COLOUR	; COLOUR vector			EhBASIC = V_COLOUR
00FB00  1  30 F7        	.word	DISP_PLOT	; PLOT vector					EhBASIC = V_PLOT
00FB02  1  89 F7        	.word	DISP_CIRCLE	; CIRCLE vector					EhBASIC = V_CIRCLE
00FB04  1  94 FA        	.word 	OUTK		; OUTK vector					EhBASIC = V_OUTK
00FB06  1  A3 F4        	.word 	DISP_TEXT_MODE ; set display back to text mode EhBASIC = V_TEXTMODE
00FB08  1               
00FB08  1               ; EhBASIC IRQ support
00FB08  1               IRQ_CODE
00FB08  1  48           	PHA				; save A
00FB09  1  A5 DF        	LDA	IrqBase		; get the IRQ flag byte
00FB0B  1  4A           	LSR				; shift the set b7 to b6, and on down ...
00FB0C  1  05 DF        	ORA	IrqBase		; OR the original back in
00FB0E  1  85 DF        	STA	IrqBase		; save the new IRQ flag byte
00FB10  1  68           	PLA				; restore A
00FB11  1  40           	RTI
00FB12  1               
00FB12  1               ; EhBASIC NMI support
00FB12  1               NMI_CODE
00FB12  1  48           	PHA				; save A
00FB13  1  A5 DC        	LDA	NmiBase		; get the NMI flag byte
00FB15  1  4A           	LSR				; shift the set b7 to b6, and on down ...
00FB16  1  05 DC        	ORA	NmiBase		; OR the original back in
00FB18  1  85 DC        	STA	NmiBase		; save the new NMI flag byte
00FB1A  1  68           	PLA				; restore A
00FB1B  1  40           	RTI
00FB1C  1               
00FB1C  1               
00FB1C  1               
00FB1C  1               
00FB1C  1               END_CODE
00FB1C  1               
