00F2AF  2               
00F2AF  2               
00F2AF  1               	.include ""
00F2AF  2               
00F2AF  1               
00F2AF  1               ; put the IRQ and MNI code in RAM so that it can be changed
00F2AF  1               
00F2AF  1               IRQ_vec	= VEC_SV+2		; IRQ code vector
00F2AF  1               NMI_vec	= IRQ_vec+$0A	; NMI code vector
00F2AF  1               
00F2AF  1               ; setup for the 6502 simulator environment
00F2AF  1               
00F2AF  1               IO_AREA	= $BFF0		; set I/O area for this monitor (Console port)
00F2AF  1               
00F2AF  1               
00F2AF  1               ;ACIAsimwr	= IO_AREA+$01	; simulated ACIA write port
00F2AF  1               ;ACIAsimrd	= IO_AREA+$04	; simulated ACIA read port
00F2AF  1               ACIAStatus	= IO_AREA		; FT245 Status
00F2AF  1               ACIAData	= IO_AREA+$01	; FT245 Data in/out
00F2AF  1               
00F2AF  1               ; Keyboard ACIA (65c51) memory locations
00F2AF  1               A_rxd           = $BFE0 ; ACIA receive data port
00F2AF  1               A_txd           = $BFE0 ; ACIA transmit data port
00F2AF  1               A_sts           = $BFE1 ; ACIA status port
00F2AF  1               A_res           = $BFE1 ; ACIA reset port
00F2AF  1               A_cmd           = $BFE2 ; ACIA command port
00F2AF  1               A_ctl           = $BFE3 ; ACIA control port
00F2AF  1               
00F2AF  1               ; Beeper bits
00F2AF  1               A_Beeper		= $BFA0 ; Beeper address
00F2AF  1               BEEP_PW			= $70		; pitch of "low" beep
00F2AF  1               BEEP_PW2		= $F0		; pitch of "high" beep
00F2AF  1               BEEP_LN			= $20
00F2AF  1               DELAY_LEN1		= $05		; Also affects pitch
00F2AF  1               BEEP_LN_CALC	= $05
00F2AF  1               
00F2AF  1               ; compact flash bits n bobs
00F2AF  1               CF_BASE			= $BFB0	; Compact flash address
00F2AF  1               CF_DATA     	= CF_BASE+0
00F2AF  1               CF_FEATURE  	= CF_BASE+1
00F2AF  1               CF_ERROR    	= CF_BASE+1
00F2AF  1               CF_SEC_CNT  	= CF_BASE+2
00F2AF  1               CF_SECTOR   	= CF_BASE+3
00F2AF  1               CF_CYL_LOW  	= CF_BASE+4
00F2AF  1               CF_CYL_HI   	= CF_BASE+5
00F2AF  1               CF_HEAD     	= CF_BASE+6
00F2AF  1               CF_STATUS   	= CF_BASE+7
00F2AF  1               CF_COMMAND  	= CF_BASE+7
00F2AF  1               CF_LBA0     	= CF_BASE+3
00F2AF  1               CF_LBA1     	= CF_BASE+4
00F2AF  1               CF_LBA2     	= CF_BASE+5
00F2AF  1               CF_LBA3     	= CF_BASE+6
00F2AF  1               
00F2AF  1               CMD_READ    	= $20
00F2AF  1               CMD_WRITE   	= $30
00F2AF  1               CMD_FEATURE 	= $EF
00F2AF  1               
00F2AF  1               CF_BUFFER 		= $04	; Start of two pages (512 bytes) of buffer
00F2AF  1               
00F2AF  1               BUFPTR      	= $40         ; Pointer to CF Read/Write Buffer (16 bit)
00F2AF  1               BUFPTRL     	= $40         ; Pointer to CF Read/Write Buffer Low Byte
00F2AF  1               BUFPTRH     	= $41         ; Pointer to CF Read/Write Buffer Low Byte
00F2AF  1               LBA_0       	= $42         ; Temp storage for LBA Byte 0
00F2AF  1               LBA_1       	= LBA_0+1     ; ... LBA Byte 1
00F2AF  1               LBA_2       	= LBA_0+2     ; ... LBA Byte 2
00F2AF  1               LBA_3       	= LBA_0+3     ; ... LBA Byte 3 (lower 4 bits only)
00F2AF  1               PAGES       	= LBA_0+4     ; Counter for number of mem pages to use
00F2AF  1               LOC				= LBA_0+5	  ; Pointer for location on CF (16 bit)
00F2AF  1               LOC_L			= LBA_0+5	  ; low byte of location on CF to save
00F2AF  1               LOC_H			= LOC_L+1	  ; low byte of location on CF to save
00F2AF  1               
00F2AF  1               CF_LB			= $0600 ; Place for low byte of sector address
00F2AF  1               CF_MB			= $0601 ; Place for middle byte of sector address
00F2AF  1               CF_HB			= $0602 ; Place for high byte of sector address
00F2AF  1               CF_LDSV			= $0603 ; Store the "are we accessing CF" variable here, used to redirect input/output
00F2AF  1               BUFF_NEWCHAR	= $604
00F2AF  1               
00F2AF  1               
00F2AF  1               
00F2AF  1               ; display addresses
00F2AF  1               DISP_DT			= $BFD0
00F2AF  1               DISP_RG			= $BFD1
00F2AF  1               DISP_WAIT		= $BFD2  ; This is the Glue logic, Bit 2 is LOW when display is busy, IGNORE all other bits
00F2AF  1               
00F2AF  1               
00F2AF  1               ; 256 byte page used for my loops and bits (away from basic)
00F2AF  1               MyDL 			= $610
00F2AF  1               MyDL2		 	= $611
00F2AF  1               MyDL3			= $612
00F2AF  1               
00F2AF  1               MyLP1			= $620
00F2AF  1               MyLP2			= $621
00F2AF  1               MyERR			= $622
00F2AF  1               
00F2AF  1               DISP_temp		= $623
00F2AF  1               DISP_ccol		= $624	; current coloumn (useful for delete)
00F2AF  1               DISP_crow		= $625	; current row (used for scrolling)
00F2AF  1               DISP_initcom	= $626
00F2AF  1               			; lines below used for plot, square, circle, line, etc
00F2AF  1               DISP_posx_h		= $627	; X position high byte
00F2AF  1               DISP_posx_l		= $628	; X position low byte
00F2AF  1               DISP_posy_h		= $629	; Y position high byte
00F2AF  1               DISP_posy_l		= $62A	; Y position low byte
00F2AF  1               DISP_posw_h		= $62B	; width high byte
00F2AF  1               DISP_posw_l		= $62C	; width low byte
00F2AF  1               DISP_posh_h		= $62D	; height high byte
00F2AF  1               DISP_posh_l		= $62E	; height low byte
00F2AF  1               DISP_col_l		= $62F	; colour for line or outline
00F2AF  1               DISP_col_t		= $630  ; colour for TEXT
00F2AF  1               DISP_fill		= $631	; fill?
00F2AF  1               DISP_dim_h		= $632
00F2AF  1               DISP_dim_l		= $632
00F2AF  1               
00F2AF  1               			; Bunch of temporary values
00F2AF  1               MyTEMP			= $650
00F2AF  1               MyTEMP2			= $651
00F2AF  1               MyTEMP3			= $652
00F2AF  1               
00F2AF  1               OutK_Y			= $655
00F2AF  1               OutK_X			= $656
00F2AF  1               
00F2AF  1               
00F2AF  1               ; now the code. all this does is set up the vectors and interrupt code
00F2AF  1               ; and wait for the user to select [C]old or [W]arm start. nothing else
00F2AF  1               ; fits in less than 128 bytes
00F2AF  1               	.segment "IOHANDLER"
00F2AF  1               	.org	$F300			; pretend this is in a 1/8K ROM
00F300  1               
00F300  1               ; reset vector points here
00F300  1               RES_vec
00F300  1  D8           	CLD				; clear decimal mode
00F301  1  A2 FF        	LDX	#$FF		; empty stack
00F303  1  9A           	TXS				; set the stack
00F304  1               
00F304  1               ; set up vectors and interrupt code, copy them to page 2
00F304  1               
00F304  1  A0 30        	LDY	#END_CODE-LAB_vec	; set index/count
00F306  1               LAB_stlp
00F306  1  B9 EB FA     	LDA	LAB_vec-1,Y		; get byte from interrupt code
00F309  1  99 04 02     	STA	VEC_IN-1,Y		; save to RAM
00F30C  1  88           	DEY					; decrement index/count
00F30D  1  D0 F7        	BNE	LAB_stlp		; loop if more to do
00F30F  1               
00F30F  1               ; set up 65c51
00F30F  1  8D E1 BF         STA A_res       ; soft reset (value not important)
00F312  1  A9 0B            LDA #$0B        ; set specific modes and functions
00F314  1                   	            ; no parity, no echo, no Tx interrupt
00F314  1                       	        ; no Rx interrupt, enable Tx/Rx
00F314  1  8D E2 BF         STA A_cmd       ; save to command register
00F317  1  A9 10            LDA #$10        ; 8-N-1, 115200 baud
00F319  1  8D E3 BF         STA A_ctl       ; set control register
00F31C  1               
00F31C  1  20 3E F8     	JSR PWR_BEEP_LOW	; power beep
00F31F  1  20 28 F4     	JSR DISP_INIT		; initialise screen
00F322  1  20 35 F8     	JSR PWR_BEEP_HIGH	; beep after display init
00F325  1               
00F325  1               	; other bits of system init
00F325  1  A9 00        	LDA #$00
00F327  1  8D 03 06     	STA CF_LDSV		; no redirect of input/output to CF
00F32A  1               
00F32A  1               
00F32A  1               	; Set colours
00F32A  1  A9 FC        	LDA #%11111100
00F32C  1  8D 30 06     	STA DISP_col_t
00F32F  1  20 69 F5     	JSR DISP_TEXT_COLOUR_direct
00F332  1  A0 00        	LDY #$0
00F334  1               LAB_dobanner
00F334  1  B9 A6 FB     	LDA	LAB_banner,Y	; get byte from sign on message
00F337  1  C9 0D        	CMP #$0D
00F339  1  D0 12        	BNE LAB_dobanner_char
00F33B  1  20 F3 E0     	JSR	V_OUTP			; output character (CR)
00F33E  1  CE 30 06     	DEC DISP_col_t		; Change colour based on row
00F341  1  CE 30 06     	DEC DISP_col_t
00F344  1  CE 30 06     	DEC DISP_col_t
00F347  1  CE 30 06     	DEC DISP_col_t
00F34A  1  20 69 F5     	JSR DISP_TEXT_COLOUR_direct
00F34D  1               
00F34D  1               LAB_dobanner_char
00F34D  1  C9 00        	CMP #$00
00F34F  1  F0 06        	BEQ LAB_presignon	; display next message
00F351  1  20 F3 E0     	JSR	V_OUTP			; output character
00F354  1  C8           	INY					; increment index
00F355  1  D0 DD        	BNE	LAB_dobanner	; loop, branch always
00F357  1               
00F357  1               LAB_presignon
00F357  1  A0 00        	LDY #$0
00F359  1  A9 E4        	LDA #%11100100
00F35B  1  8D 30 06     	STA DISP_col_t
00F35E  1  20 69 F5     	JSR DISP_TEXT_COLOUR_direct
00F361  1               
00F361  1               LAB_signon				; now do the signon message, Y = $00 here
00F361  1  B9 79 FC     	LDA	LAB_mess,Y		; get byte from sign on message
00F364  1  F0 06        	BEQ KYB_msg			; display next message
00F366  1               
00F366  1  20 F3 E0     	JSR	V_OUTP			; output character
00F369  1  C8           	INY					; increment index
00F36A  1  D0 F5        	BNE	LAB_signon		; loop, branch always
00F36C  1               
00F36C  1               KYB_msg
00F36C  1  20 1A F4     	JSR KYB_cwmmsg
00F36F  1               
00F36F  1               LAB_nokey
00F36F  1  20 F0 E0     	JSR	V_INPT			; call scan input device
00F372  1  90 FB        	BCC	LAB_nokey		; loop if no key
00F374  1               
00F374  1  20 A9 F3     	JSR	ACIAout			; output character
00F377  1               
00F377  1  29 DF        	AND	#$DF			; mask xx0x xxxx, ensure upper case
00F379  1  C9 57        	CMP	#'W'			; compare with [W]arm start
00F37B  1  F0 16        	BEQ	LAB_dowarm		; branch if [W]arm start
00F37D  1               
00F37D  1  C9 4D            CMP #'M'
00F37F  1  F0 1D            BEQ LAB_dowoz
00F381  1               
00F381  1  C9 43        	CMP	#'C'			; compare with [C]old start
00F383  1  F0 03        	BEQ LAB_docold
00F385  1  4C 00 F3     	JMP RES_vec
00F388  1               
00F388  1               LAB_docold
00F388  1  A9 0D        	LDA #$0D
00F38A  1  8D E0 BF     	STA A_txd			; clear keyboard screen
00F38D  1  20 FE F3     	JSR KYB_basmsg
00F390  1  4C 00 C0     	JMP	LAB_COLD		; do EhBASIC cold start
00F393  1               
00F393  1               LAB_dowarm
00F393  1  A9 0D        	LDA #$0D
00F395  1  8D E0 BF     	STA A_txd			; clear keyboard screen
00F398  1  20 FE F3     	JSR KYB_basmsg
00F39B  1  4C 00 00     	JMP	LAB_WARM		; do EhBASIC warm start
00F39E  1               LAB_dowoz
00F39E  1  A9 0D        	LDA #$0D
00F3A0  1  8D E0 BF     	STA A_txd			; clear keyboard screen
00F3A3  1  20 0C F4     	JSR KYB_wozmsg
00F3A6  1  4C 00 F0         JMP EWOZ
00F3A9  1               
00F3A9  1               ; byte out to simulated ACIA
00F3A9  1               ACIAout
00F3A9  1  48           	PHA
00F3AA  1               
00F3AA  1               SWait:
00F3AA  1  AD F0 BF     	LDA	ACIAStatus
00F3AD  1  29 02        	AND	#2
00F3AF  1  C9 02        	CMP	#2
00F3B1  1  D0 F7        	BNE	SWait
00F3B3  1  68           	PLA
00F3B4  1  8D F1 BF     	STA	ACIAData
00F3B7  1               
00F3B7  1               	; Send output to display
00F3B7  1  48           	PHA
00F3B8  1  20 9F F5     	JSR DISP_TEXT_WR
00F3BB  1  68           	PLA
00F3BC  1               
00F3BC  1               ACIAout_exit
00F3BC  1               ; end of screen output code
00F3BC  1  60           	RTS						; end of ACIAout
00F3BD  1               
00F3BD  1               
00F3BD  1               
00F3BD  1               
00F3BD  1               
00F3BD  1               ; byte in from simulated ACIA
00F3BD  1               
00F3BD  1               ; byte out to keyboard 65c51
00F3BD  1               KEYBout
00F3BD  1  8D E0 BF     	STA A_txd			; send character to keyboard display
00F3C0  1  48           	PHA					; save A
00F3C1  1               
00F3C1  1  A9 FF        	LDA #$FF
00F3C3  1  8D 10 06     	STA MyDL
00F3C6  1               KEYDL				; Outer loop
00F3C6  1  A9 40        	LDA #$40
00F3C8  1  8D 11 06     	STA MyDL2
00F3CB  1               KEYDL2				; Inner loop
00F3CB  1  CE 11 06     	DEC MyDL2
00F3CE  1  D0 FB        	BNE	KEYDL2
00F3D0  1               
00F3D0  1  CE 10 06     	DEC MyDL
00F3D3  1  D0 F1        	BNE KEYDL		; if not 0 increment more
00F3D5  1               
00F3D5  1  68           	PLA
00F3D6  1  60           	RTS
00F3D7  1               
00F3D7  1               LAB_WAIT_Rx
00F3D7  1  AD E1 BF         LDA A_sts       ; get ACIA status
00F3DA  1  29 08            AND #$08        ; mask rx buffer status flag
00F3DC  1  F0 F9            BEQ LAB_WAIT_Rx ; loop if rx buffer empty
00F3DE  1               
00F3DE  1  AD E0 BF         LDA A_rxd       ; get byte from ACIA data port
00F3E1  1               
00F3E1  1               
00F3E1  1               ; byte in from simulated ACIA (CONSOLE) or Keyboard
00F3E1  1               ACIAin
00F3E1  1  AD F0 BF     	LDA	ACIAStatus
00F3E4  1  29 01        	AND	#1
00F3E6  1  C9 01        	CMP	#1
00F3E8  1  D0 05        	BNE	NoDataIn
00F3EA  1  AD F1 BF     	LDA	ACIAData
00F3ED  1  38           	SEC		; Carry set if key available
00F3EE  1  60           	RTS
00F3EF  1               NoDataIn:	; nothing from console port
00F3EF  1  18           	CLC		; Carry clear if no key pressed
00F3F0  1               
00F3F0  1               KEY_RX		; we get here if there is no data from console
00F3F0  1  AD E1 BF         LDA A_sts       ; get ACIA status
00F3F3  1  29 08            AND #$08        ; mask rx buffer status flag
00F3F5  1  F0 05            BEQ KEYB_NoData ; skip if rx buffer empty
00F3F7  1               
00F3F7  1  AD E0 BF         LDA A_rxd       ; get byte from ACIA data port
00F3FA  1  38           	SEC				; Carry set if key available
00F3FB  1  60           	RTS
00F3FC  1               
00F3FC  1               KEYB_NoData
00F3FC  1  18           	CLC				; Carry clear if no key pressed
00F3FD  1  60           	RTS
00F3FE  1               
00F3FE  1               
00F3FE  1               ; Show "EhBASIC " on keyboard display
00F3FE  1               KYB_basmsg
00F3FE  1  A0 00        	LDY #$00
00F400  1               
00F400  1               KYB_basmsg_lp
00F400  1  B9 A2 FC     	LDA KYB_basmess_str,Y
00F403  1  F0 06        	BEQ	KYB_basmsg_exit	; exit loop if done
00F405  1               
00F405  1  20 BD F3     	JSR KEYBout			;
00F408  1  C8           	INY					; increment index
00F409  1  D0 F5        	BNE KYB_basmsg_lp	; loop, always
00F40B  1               
00F40B  1               KYB_basmsg_exit
00F40B  1  60           	RTS
00F40C  1               
00F40C  1               ; Show "eWOZMON " on keyboard display
00F40C  1               KYB_wozmsg
00F40C  1  A0 00        	LDY #$00
00F40E  1               
00F40E  1               KYB_wozmsg_lp
00F40E  1  B9 AD FC     	LDA KYB_wozmess_str,Y
00F411  1  F0 06        	BEQ	KYB_wozmsg_exit	; exit loop if done
00F413  1               
00F413  1  20 BD F3     	JSR KEYBout			;
00F416  1  C8           	INY					; increment index
00F417  1  D0 F5        	BNE KYB_wozmsg_lp	; loop, always
00F419  1               
00F419  1               KYB_wozmsg_exit
00F419  1  60           	RTS
00F41A  1               
00F41A  1               ; send signon message to keyboard
00F41A  1               KYB_cwmmsg
00F41A  1  A0 00        	LDY #$00
00F41C  1               
00F41C  1               KYB_signon
00F41C  1  B9 98 FC     	LDA KYB_mess,Y
00F41F  1  F0 06        	BEQ	KEYB_exit		; exit loop if done
00F421  1               
00F421  1  20 BD F3     	JSR KEYBout			;
00F424  1  C8           	INY					; increment index
00F425  1  D0 F5        	BNE KYB_signon		; loop, always
00F427  1               KEYB_exit
00F427  1  60           	RTS
00F428  1               
00F428  1               
00F428  1               ; ----- DISPLAY BITS
00F428  1               ; display driver for the LT6502 project using the RA8875 driver
00F428  1               ; the display is set to 800x480 pixels
00F428  1               DISP_INIT
00F428  1               		; write to reg 0 and read back driver chip number
00F428  1  A9 00        	LDA #$00
00F42A  1  8D D1 BF     	STA DISP_RG
00F42D  1  20 07 F6     	JSR DISP_CHK_BUSY
00F430  1  AD D0 BF     	LDA DISP_DT
00F433  1  C9 75        	CMP #$75		;$75 means it's an RA8875 driver chip
00F435  1  F0 03        	BEQ DISP_OK
00F437  1  4C 60 F4     	JMP DISP_ERR
00F43A  1               
00F43A  1               DISP_OK
00F43A  1               
00F43A  1               	; 56 bytes in our initialisation array
00F43A  1  A2 00        	LDX #$00
00F43C  1               DISP_initloop
00F43C  1  BD 1C FB     	LDA	DISP_INIT_data,X		; get REGISTER value from array
00F43F  1  E8           	INX
00F440  1  BC 1C FB     	LDY DISP_INIT_data,X		; get DATA value from array
00F443  1  20 75 F6     	JSR DISP_writereg			; WRITE DATA
00F446  1  E8           	INX
00F447  1  8A           	TXA
00F448  1  C9 38        	CMP #56
00F44A  1  D0 F0        	BNE DISP_initloop
00F44C  1               
00F44C  1  20 67 F4     	JSR DISP_CLR_SCREEN
00F44F  1  20 A3 F4     	JSR DISP_TEXT_MODE
00F452  1  20 E2 F4     	JSR DISP_CURSOR_SETXY
00F455  1  48           	PHA
00F456  1  A9 E4        	LDA #%11100100
00F458  1  8D 30 06     	STA DISP_col_t
00F45B  1  20 69 F5     	JSR DISP_TEXT_COLOUR_direct
00F45E  1  68           	PLA
00F45F  1  60           	RTS
00F460  1               	; end of DISP_INIT
