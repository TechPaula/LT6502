00F6A7  1               	;; layer I'm using!
00F6A7  1  A9 54        	lda #$54          ; LSB of X coordinate
00F6A9  1  A0 00        	ldy #0            ; starting at 0, 16
00F6AB  1  20 75 F6     	jsr DISP_writereg
00F6AE  1  A9 55        	lda #$55          ; MSB of X coordinate
00F6B0  1  A0 00        	ldy #0            ; starting at 0, 16
00F6B2  1  20 75 F6     	jsr DISP_writereg
