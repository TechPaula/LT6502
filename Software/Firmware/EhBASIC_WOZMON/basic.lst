00F328  1  F0 06        	BEQ KYB_msg			; display next message
00F32A  1               
00F32A  1  20 F9 E0     	JSR	V_OUTP			; output character
00F32D  1  C8           	INY					; increment index
00F32E  1  D0 F5        	BNE	LAB_signon		; loop, branch always
00F330  1               
