5000 REM -- MANDLEBROT
5005 PRINT "DRAW MANDLEBROT SET"
5010 FOR Y=-120 TO 120
5020 FOR X=-260 TO 137
5030 CA= X*0.009666
5040 CB= Y*0.011167
5050 A=CA
5060 B=CB
5070 FOR I=0 TO 15
5080 T=A*A-B*B+CA
5090 B=2*A*B+CB
5100 A=T
5110 IF (A*A+B*B)>4 THEN GOTO 5200
5120 NEXT I
5131 PC = %00100000
5132 GOSUB 3300
5140 GOTO 5210
5200 PC = 255-((I+1)*15)
5202 GOSUB 3300
5203 IF I>9 THEN I=I+7
5210 PX = PX + 2
5220 NEXT X
5230 PY = PY + 2
5235 PX = $02
5236 PRINT Y
5240 NEXT Y
5299 RETURN





3300 REM -- DRAW SQUARE
3301 REM USING PX, PY AND PC

3304 REM YT AND XT HOLD OTHER CORNER
3305 REM HT AND WD ARE HEIGHT AND WIDTH
3307 YT = HT + PY - 1
3308 XT = WD + PX - 1

3310 XM = PX >> 8
3312 TD = XM * 256
3313 XL = PX - TD

3320 YM = PY >> 8
3322 TD = YM * 256
3323 YL = PY - TD

3330 POKE RG,$91
3335 POKE DT,XL
3340 POKE RG,$92
3345 POKE DT,XM
3350 POKE RG,$93
3355 POKE DT,YL
3360 POKE RG,$94
3365 POKE DT,YM

3368 HM = YT >> 8
3369 TD = HM * 256
3370 HL = YT - TD

3371 WM = XT >> 8
3372 TD = WM * 256
3373 WL = XT - TD


3374 POKE RG,$95
3375 POKE DT,WL
3380 POKE RG,$96
3385 POKE DT,WM
3390 POKE RG,$97
3395 POKE DT,HL
3400 POKE RG,$98
3405 POKE DT,HM


3410 REM - SPLIT COLOURS
3420 PR = PC >> 5
3422 TD = PR * 32
3424 PG = PC - TD
3426 PG = PG >> 2
3428 TD = PC >> 2
3430 TD = TD * 4
3432 PB = PC - TD

3440 POKE RG,$63
3445 POKE DT,PR
3450 POKE RG,$64
3455 POKE DT,PG
3460 POKE RG,$65
3465 POKE DT,PB

3470 POKE RG,$90
3471 POKE DT,$90
3480 TD = PEEK(DT)
3483 IF TD > 127 THEN GOTO 3480
3499 RETURN



