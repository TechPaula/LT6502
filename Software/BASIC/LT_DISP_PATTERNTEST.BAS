10 REM -- TEST PATTERNS
20 CLS
30 R = RND(123456)

50 COLOUR 229
60 PRINT "  GRAPHICS TEST"
70 OUTK "Graphics"
90 MODE 1


100 FOR T = 0 TO 500
110 X = RND(0)*800
120 Y = RND(0)*480
130 PLOT X,Y,255-(T/2)
140 NEXT T


200 FOR T = 0 TO 25
210 X = RND(0)*800
220 Y = RND(0)*480
230 R = (RND(0)*7)+3
240 CIRCLE X,Y,R,T*10,1
250 NEXT T


300 FOR T = 0 TO 480 STEP 5
310 LINE 1,T,T,480,T/2
320 NEXT T

400 FOR T = 0 TO 200 STEP 5
410 SQUARE 595+T, 270+T, 795-T, 475-T, T, 0
420 NEXT T

500 FOR T = 0 TO 200 STEP 5
510 ELIPSE 300,240,205-T,T,255-T,0
520 NEXT T

600 FOR T = 0 TO 200 STEP 5
610 TRIANGLE 595+T,T, 795-T,T, 695, 200-T, T, 0
620 NEXT T



999 MODE 0
