10 REM -- BIFURCATION PLOT
15 CLS
17 INPUT "START [1 - 2.9]";ST
18 INPUT "FINISH [3 - 3.99]";FI
20 MODE 1
30 REM DEFSNG A-Z
35 CL = %10001110
40 CO = 800
50 RO = 480
60 REM ST = 2.75    : REM 1 IS THE NORMAL START
70 REM FI = 3.999
80 TP = 0
90 BT = 1
100 MR = 10
110 HT = BT - TP
120 VP = 1/HT

130 FOR R = ST TO FI STEP((FI - ST)/CO)
140 X = .1
150 FOR I = 1 TO 100
160 X = R * (X - X * X)
170 NEXT I
180 FOR I = 1 TO 30
190 X = R * (X - X * X)

200 PX = (R-ST) * CO/(FI-ST)
201 PY = RO-(X-TP) * RO * VP
202 PLOT PX,PY,CL


210 NEXT I
220 NEXT R

300 MODE 0
310 COLOUR %11100100
320 END
