10 REM -- TEXT GAME OF LIFE
15 OUTK "--GoL--"
20 YM = 24
25 XM = 24
30 DIM L(XM,YM)
35 DIM N(XM,YM)
40 CLS
50 BS = 7
55 SP = (BS*2) + 2

60 W = RND(0)


80 CLS
100 FOR I=1 TO XM
110 FOR J=1 TO YM
120 IF RND(0)>=.7 THEN N(I,J) = 1 ELSE N(I,J) = 0
130 NEXT J
140 NEXT I


1085 SQUARE 0,0,SP+(XM*SP),SP+(YM*SP),255,0


1090 CURSOR XM+XM+SP,0
1091 PRINT "Cyc#";G

1100 FOR I=1 TO XM
1110 FOR J=1 TO YM
1115 W = N(I,J) : L(I,J) = W
1130 IF W=0 THEN GOSUB 2000; ELSE GOSUB 3000;
1160 NEXT J
1170 NEXT I

1180 FOR I=1 TO XM
1190 FOR J=1 TO YM
1200 NC=0
1210 FOR K=I-1 TO I+1
1215 IF K=0 OR K>XM THEN GOTO 1260
1220 FOR W=J-1 TO J+1
1230 IF W=0 OR W>YM OR (K=I AND W=J) THEN 1250
1240 NC = NC + L(K,W)
1250 NEXT W
1260 NEXT K
1270 IF NC=2 THEN N(I,J)=L(I,J) : GOTO 1300
1280 IF NC=3 THEN N(I,J)=1 ELSE N(I,J)=0
1300 NEXT J
1310 NEXT I

1350 G=G+1
1355 OUTK "Cyc#"
1356 OUTK G
1360 GOTO 1090

2000 CIRCLE I*SP,J*SP,BS,0,1
2010 RETURN
3000 CIRCLE I*SP,J*SP,BS,%11111100,1
3010 RETURN
