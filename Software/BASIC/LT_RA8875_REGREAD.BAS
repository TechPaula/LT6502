10 REM -----------------------------
11 REM RA8875 READ TEST
20 DT = $BFD0
21 RG = $BFD1
30 DA = 0        : REM DATA
31 TD = 0        : REM TEMP DATA
50 DATA $48,$65,$6C,$6C,$6F,$20,$77,$6F
51 DATA $72,$6C,$64,$21,$20,$20,$20,$FF
90 GOSUB 9000    : REM REGISTER DUMP

8999 END


9000 REM --- DUMP ALL REGISTERS
9005 PRINT "REG dump:"
9006 TD = 0
9010 FOR L1 = 0 TO 15
9012 PRINT HEX$(L1*16,2);
9013 PRINT "-";
9014 PRINT HEX$((L1*16)+15,2);
9015 PRINT ": ";
9020 FOR L2 = 0 TO 15
9030 POKE RG,TD         : REM SET REG TO READ
9040 DA = PEEK(DT)      : REM READ REGISTER
9050 PRINT HEX$(DA,2);  : REM PRINT REG VALUE
9060 PRINT " ";
9070 TD=TD+1
9080 NEXT L2
9090 PRINT ""
9095 NEXT L1
9096 TD = 0
9099 RETURN
10000 REM -- DELAY 1 (~70mS)
10010 FOR DL = 0 TO 200
10020 NEXT DL
10030 RETURN
10100 REM --DELAY 2 (~650mS)
10110 FOR DL = 0 TO 2000
10120 NEXT DL
10130 RETURN
