 1 REM !!!! FORMAT CF CARD !!!!
 2 REM THIS WIPES THE "INFO" SECTOR OF 
 3 REM  EACH SAVE SLOT
 4 REM THIS TAKES A LOOOONG TIME


 10 H$ = "0123456789ABCDEF"
 20 B$ = "  "
 30 W$ = "    "
 40 CF =$BFB0
 
 50 FOR BU = $400 TO $5FF
 51 POKE BU,$00
 52 NEXT BU

 53 BU =$0400
 
 60 S = 0
 65 SM = 0
 66 SH = 0


 70 INPUT "ARE YOU SURE ";I$
 71 IF I$ <> "Y" THEN GOTO 999

 75 INPUT "DO YOU WANT TO QUIT ";I$
 76 IF I$ <> "N" THEN GOTO 999

 77 INPUT "SECTOR START";S

 80 REM SET 8 BIT MODE
 83 POKE CF+1,1 : REM 8 BIT MODE
 84 POKE CF+7,239
 85 REM SET FOR 1 SECTOR AT A TIME
 86 POKE CF+2,1
 

 100 SM = INT(S / 256)
 101 SM = 256 * SM
 102 SL = S - SM
 103 SM = INT(SM/256)
 110 PRINT "SECTOR:"; 
 111 PRINT S,
 112 PRINT SH,
 113 PRINT SM,
 114 PRINT SL


 150 REM SET LBA ADDRESS BYTES
 160 POKE CF+3,SL
 170 POKE CF+4,SM
 180 POKE CF+5,SH
 190 POKE CF+6,224
 200 REM START SECTOR WRITE
 210 POKE CF+7,48

 300 FOR X = BU TO BU+511
 310 Z = PEEK(X)
 320 POKE CF,Z
 330 NEXT X

 350 FOR DL = 0 TO 100
 360 NEXT DL


 400 S = S + 256
 410 IF S < 65535 THEN GOTO 80
 420 S = 0
 430 SH = SH + 1
 440 IF SH < 256 THEN GOTO 80


999 END




