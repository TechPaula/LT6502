 1 REM !!!! FORMAT CF CARD !!!!
 2 REM THIS WIPES THE "INFO" SECTOR OF 
 3 REM  EACH SAVE SLOT
 4 REM THIS TAKES A LOOOONG TIME


 10 H$ = "0123456789ABCDEF"
 20 B$ = "  "
 30 W$ = "    "
 40 CF =$BFB0
 
 50 FOR BU = $400 TO $5FF
 51 POKE BU,$00
 52 NEXT BU

 53 BU =$0400
 
 60 S = 0
 65 SM = 0
 66 SH = 0


 70 INPUT "ARE YOU SURE ";I$
 71 IF I$ <> "Y" THEN GOTO 999

 75 INPUT "DO YOU WANT TO QUIT ";I$
 76 IF I$ <> "N" THEN GOTO 999

 77 INPUT "SM START ";SM
 78 INPUT "SH START ";SH

 80 REM SET 8 BIT MODE
 83 POKE CF+1,1 : REM 8 BIT MODE
 84 POKE CF+7,239
 85 REM SET FOR 1 SECTOR AT A TIME
 86 POKE CF+2,1
 

 110 PRINT "SECTOR:"; 
 111 PRINT S,
 112 PRINT SH,
 113 PRINT SM,
 114 PRINT SL


 150 REM SET LBA ADDRESS BYTES
 160 POKE CF+3,SL
 170 POKE CF+4,SM
 180 POKE CF+5,SH
 190 POKE CF+6,224
 200 REM START SECTOR WRITE
 210 POKE CF+7,48

 300 FOR X = 0 TO 511
 320 POKE CF,$00
 330 NEXT X

 
 

 400 SM = SM + 1
 410 IF SM < 256 THEN GOTO 80
 420 SM = 0
 425 REM - STOP AFTER 2048 SLOTS
 426 REM   JUST BECAUSE 2048 IS A LOT
 427 REM   AND BLANKING MORE TAKES HOURS
 430 SH = SH + 1
 440 IF SH < 9 THEN GOTO 80
 

999 END




