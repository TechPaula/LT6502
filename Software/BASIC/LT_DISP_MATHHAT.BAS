10 REM -- Math hat

100 CLS
105 MODE 1

110 REM PI = 3.1415926
120 XP = 240
120 XP = 90
130 XR = 1.5 * PI
140 YP = 90
150 XF = XR / XP

300 FOR ZI = -YP TO YP
310 ZT = ZI * XP / YP
320 XL = INT(0.5 + SQR(XP * XP - ZT * ZT))

330 FOR XI = -XL TO XL
340 XT = SQR(XI * XI + ZT * ZT) * XF
350 YY = (SIN(XT) + 0.4 * SIN(3 * XT)) * YP

360 Y1 = INT(YY - ZI + 300)
370 X1 = INT(XI + ZI + 220)

505 X = X1*2
506 Y = Y1

510 PLOT X,480-Y,%11000100

630 LINE (X1-1)*2,480-((Y1-1)),(X1-1)*2,480, 0

700 NEXT XI
710 NEXT ZI

800 MODE 0
810 COLOUR %11000100


