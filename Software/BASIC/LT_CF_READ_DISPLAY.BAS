5000 REM CF READ SETUP
5010 H$ = "0123456789ABCDEF"
5020 B$ = "  "
5030 W$ = "    "
5040 CF =$BFB0
5050 BU =$400
5055 LN = 0
5060 INPUT "SECTOR";S
5065 SM = 0
5066 SH = 0
5075 SM = INT(S / 256)
5076 SM = 256 * SM
5077 S = S - SM
5078 SM = INT(SM/256)
5097 PRINT "S:"; : PRINT S, 
5098 PRINT "SM:"; : PRINT SM, 
5099 PRINT "SH:"; : PRINT SH


5100 REM CF INIT - SET 8 BIT MODE
5110 POKE CF+1,1 : REM 8 BIT MODE
5120 POKE CF+7,239
5130 REM SET FOR 1 SECTOR AT A TIME
5140 POKE CF+2,1
5150 REM SET LBA ADDRESS BYTES
5160 POKE CF+3,S
5170 POKE CF+4,SM
5180 POKE CF+5,SH
5190 POKE CF+6,224
5200 REM START SECTOR READ
5210 POKE CF+7,32

5300 FOR X = BU TO BU+511
5305 BY = PEEK(CF)
5310 POKE X,BY
5320 NEXT X

6000 FOR X = BU TO BU+511 STEP 16
6003 WD = X
6005 GOSUB 8100
6006 POKE RG,$02
6007 PRINT W$;"  ";
6007 POKE DT,ASC(W$)
6008 POKE DT,ASC(" ")
6010 FOR Y = 0 TO 15
6020 BY = PEEK(X+Y)
6030 GOSUB 8000
6040 PRINT B$;" ";
6040 POKE DT,ASC(B$)
6041 POKE DT,ASC(" ")
6050 IF Y = 7 THEN PRINT"   ";
6050 IF Y = 7 THEN POKE DT,ASC(" ")
6060 NEXT Y
6070 PRINT "    ";
6070 POKE DT,ASC(" ")
6071 POKE DT,ASC(" ")
6072 POKE DT,ASC(" ")
6080 FOR Y = 0 TO 15
6090 BY = PEEK(X+Y)
6100 IF BY <128 AND BY > 31 THEN PRINT CHR$(BY);
6100 IF BY <128 AND BY>31 THEN POKE DT,BY
6110 IF BY <32 OR BY > 127 THEN PRINT ".";
6110 IF BY <32 OR BY >127 THEN POKE DT,ASC(".")
6120 IF Y = 7 THEN PRINT "  ";
6120 IF Y = 7 THEN POKE DT,ASC(" ")
6130 NEXT Y
6200 PRINT
6200 LN = LN + 1
6250 GOSUB 1550

6390 NEXT X
6399 RETURN

8000 REM ***************************************
8001 REM * CONVERT BYTE TO HEX                 *
8002 REM *************************************** 
8003 REM
8010 BH = INT(BY/16)
8020 BL = BY - (BH*16)
8030 B$ = MID$(H$,BH+1,1)+MID$(H$,BL+1,1)
8040 RETURN
8100 REM ***************************************
8101 REM * CONVERT WORD TO HEX                 *
8102 REM *************************************** 
8103 REM
8110 BY = INT(WD/256)
8120 GOSUB 8000
8130 WH$ = B$
8140 BY = WD - (BY*256)
8150 GOSUB 8000
8160 WL$ = B$
8170 W$ = WH$ + WL$
8180 RETURN

