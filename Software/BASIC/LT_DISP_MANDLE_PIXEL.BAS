10 REM -------------------------
11 REM DISPLAY MANDLEBROT
12 REM ON LAPTOP 800X480 SCREEN
13 REM NOW USING SINGLE PIXEL
14 REM --
15 REM THIS NOW NEEDS THE RA8875 
16 REM TO HAVE BEEN INIT'D BY THE
17 REM BIOS

20 DT = $BFD0
21 RG = $BFD1

30 DA = 0        : REM DATA
31 TD = 0        : REM TEMP DATA

40 PX = $00       : REM PIXEL X POSITION 
41 PY = $00        : REM PIXEL Y POSITION
42 PC = $00        : REM PIXEL COLOUR

49 REM  COLOUR SCHEME RRRGGGBB
50 DATA %00100000, %01000000, %01000100, %01100100
51 DATA %10000100, %10100100, %11000100, %11100100
52 DATA %11101000, %11101100, %11110000, %11110100
53 DATA %11111000, %11111100, %11111100, %11111110

310 CLS
315 PRINT "Mandelbrot set 800X480, 16 itterations"
330 MODE 1        : REM GRAPHICS MODE

500 GOSUB 5000	  : REM draw mandelbrot

509 REM -- DRAW RECTANGLE
510 PX = $0000
515 PY = $0000
520 PC = $FF
525 HT = 480
530 WD = 800
535 GOSUB 3300



540 MODE 0        : REM got back to text mode
550 PRINT "COMPLETE"

998 END
1050 REM -- GRAPHICS MODE
1056 POKE RG,$40
1057 TD = PEEK(DT)
1060 POKE RG,$40
1065 POKE DT,%00000000   : REM GRAPHICS MODE
1070 GOSUB 10000   : REM DELAY 1
1099 RETURN


3300 REM -- DRAW SQUARE
3301 REM USING PX, PY AND PC

3304 REM YT AND XT HOLD OTHER CORNER
3305 REM HT AND WD ARE HEIGHT AND WIDTH
3307 YT = HT + PY - 1
3308 XT = WD + PX - 1

3310 XM = PX >> 8
3312 TD = XM * 256
3313 XL = PX - TD

3320 YM = PY >> 8
3322 TD = YM * 256
3323 YL = PY - TD

3330 POKE RG,$91
3335 POKE DT,XL
3340 POKE RG,$92
3345 POKE DT,XM
3350 POKE RG,$93
3355 POKE DT,YL
3360 POKE RG,$94
3365 POKE DT,YM

3368 HM = YT >> 8
3369 TD = HM * 256
3370 HL = YT - TD

3371 WM = XT >> 8
3372 TD = WM * 256
3373 WL = XT - TD


3374 POKE RG,$95
3375 POKE DT,WL
3380 POKE RG,$96
3385 POKE DT,WM
3390 POKE RG,$97
3395 POKE DT,HL
3400 POKE RG,$98
3405 POKE DT,HM


3410 REM - SPLIT COLOURS
3420 PR = PC >> 5
3422 TD = PR * 32
3424 PG = PC - TD
3426 PG = PG >> 2
3428 TD = PC >> 2
3430 TD = TD * 4
3432 PB = PC - TD

3440 POKE RG,$63
3445 POKE DT,PR
3450 POKE RG,$64
3455 POKE DT,PG
3460 POKE RG,$65
3465 POKE DT,PB

3470 POKE RG,$90
3471 POKE DT,$90
3480 TD = PEEK(DT)
3483 IF TD > 127 THEN GOTO 3480
3499 RETURN


3500 REM -- PLOT SINGLE PIXEL
3510 YH = PY >> 8
3515 TD = YH * 256
3517 YL = PY - TD
3520 XH = PX >> 8
3525 TD = XH * 256
3527 XL = PX - TD
3550 POKE RG,$46
3555 POKE DT, XL
3560 POKE RG,$47
3565 POKE DT, XH
3570 POKE RG,$48
3575 POKE DT, YL
3580 POKE RG,$49
3585 POKE DT, YH
3590 POKE RG,$02
3600 REM RRRGGGBB
3605 POKE DT,PC
3699 RETURN


5000 REM -- MANDLEBROT
5010 FOR Y=-240 TO 240
5020 FOR X=-520 TO 275
5030 CB= Y*0.0055835
5040 CA= X*0.004833
5050 A=CA
5060 B=CB
5070 FOR I = 0 TO 15
5080 T=A*A-B*B+CA
5090 B=2*A*B+CB
5100 A=T
5110 IF (A*A+B*B)>4 THEN GOTO 5200
5120 NEXT I
5131 PC = %00000000
5132 GOSUB 3500
5140 GOTO 5210

5200 REM SORT COLOURS
5201 RESTORE
5202 FOR LP = 0 TO I
5203 READ PC 
5205 NEXT LP

5208 GOSUB 3500
5209 IF I>9 THEN I=I+7

5210 PX = PX + 1
5220 NEXT X
5230 PY = PY + 1
5235 PX = $02
5240 NEXT Y
5299 RETURN


10000 REM -- DELAY 1 (~70mS)
10010 FOR DL = 0 TO 200
10020 NEXT DL
10030 RETURN

10100 REM --DELAY 2 (~650mS)
10110 FOR DL = 0 TO 2000
10120 NEXT DL
10130 RETURN
