10 REM ---- bubble-verse

20 DT = $BFD0
21 RG = $BFD1


50 CLS          
60 PRINT "LT6502 Bubbleverse"
65 T = 0
70 INPUT "Start";T
110 N = 200
120 TA = (2*PI)/235
130 R = TA / 235

140 X = 0 
150 V = 0 
160 REM T = 0 
170 HS = 200   : REM this uses width of screen
175 VS = 120
180 GW = 400
190 GH = 240

200 MODE 1     : REM Switch to graphics mode


300 REM -- MAIN LOOP
320 FOR I = 0 TO N 
330 FOR J = 0 TO N
340 U = SIN(I+V) + SIN((R * I) + X)
350 V = COS(I+V) + COS((R * I) + X)
360 X = U + T
370 GOSUB 1000
380 GOSUB 2000
390 NEXT J
400 NEXT I
410 T = T + (1/N)
410 T = T + 1
420 REM PRINTK T
430 BEEP 100
450 GOTO 300 


1000 REM -- CALC COLOURS
1020 PR = INT(I / 25)
1021 IF PR < 8 THEN GOTO 1030
1022 PR = 7

1030 PG = INT(J / 25)
1031 IF PG < 8 THEN GOTO 1040
1032 PG = 7

1040 PB = 1
1060 PC = PR << 5
1070 TP = PG << 2
1080 PC = PC + TP + PB
1999 RETURN


2000 REM -- CALC DOT POSITION AND PLOT
2040 PX = INT(GW+(U*HS))
2050 PY = INT(GH+(V*VS))
2060 GOSUB 3500


2999 RETURN

3500 REM -- PLOT SINGLE PIXEL
3510 YH = PY >> 8
3515 TD = YH * 256
3517 YL = PY - TD
3520 XH = PX >> 8
3525 TD = XH * 256
3527 XL = PX - TD
3550 POKE RG,$46
3555 POKE DT, XL
3560 POKE RG,$47
3565 POKE DT, XH
3570 POKE RG,$48
3575 POKE DT, YL
3580 POKE RG,$49
3585 POKE DT, YH
3590 POKE RG,$02
3600 REM RRRGGGBB
3605 POKE DT,PC
3699 RETURN


