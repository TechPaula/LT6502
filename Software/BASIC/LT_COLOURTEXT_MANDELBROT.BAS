10 REM -- TEXT MANDLEBROT WITH COLOUR


49 REM  COLOUR SCHEME RRRGGGBB
50 DATA %00100001, %01000001, %01000100, %01100100
51 DATA %10000100, %10100100, %11000100, %11100100
52 DATA %11101000, %11101100, %11110000, %11110100
53 DATA %11111000, %11111100, %11111100, %11111110

100 CLS
110 FOR Y=-13 TO 13
120 FOR X=-60 TO 35
130 CA= X*0.0358
140 CB= Y*0.08333
150 A=CA
160 B=CB
170 FOR I=0 TO 15
180 T=A*A-B*B+CA
190 B=2*A*B+CBC
200 A=T
210 IF (A*A+B*B)>4 THEN GOTO 300
220 NEXT I
225 COLOUR %00100001
230 PRINT " ";
240 GOTO 310
300 REM IF I>9 THEN I=I+7

301 RESTORE
302 FOR LP = 0 TO I
303 READ PC 
304 NEXT LP
305 COLOUR PC

307 IF I>9 THEN I=I+7
308 PRINT CHR$(48+I);
310 NEXT X
320 PRINT
330 NEXT Y

350 COLOUR %11100100
