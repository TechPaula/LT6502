10 REM -- BALL BOUNCE 
12 C = RND(123456)
15 CLS
20 INPUT "X:";X
30 INPUT "Y:";Y
40 INPUT "R:";R
50 INPUT "C:";C
60 INPUT "F:";F
65 INPUT "S:";S
66 CLS
70 XD = R/2
80 YD = R/2
90 MODE 1
100 CIRCLE XO,YO,R,0,FO
105 CIRCLE X,Y,R,C,F
110 FOR LP = 0 TO S
115 NEXT LP
117 XO = X
118 YO = Y
120 FO = F
130 X = X + XD
140 IF X > 800-R THEN GOTO 150
145 IF X > 0+R THEN GOTO 200
150 XD = XD * - 1
160 REM BEEP 255
170 C = 1+(RND(0)*254)
200 Y = Y + YD
210 IF Y > 480-R THEN GOTO 250
220 IF Y > 0+R THEN GOTO 100
250 YD = YD * - 1
260 REM BEEP 0
270 C = 1+(RND(0)*254)
300 GOTO 100

