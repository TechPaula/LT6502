10 REM -- DUAL BALL BOUNCE 
12 C = RND(123456)
15 CLS
20 INPUT "Start X:";X
30 INPUT "Start Y:";Y
40 INPUT "Radius:";R
50 INPUT "Colour:";C
60 INPUT "Fill [0 = no]:";F
65 INPUT "Speed [bigger = slower]:";S
66 CLS
70 XD = R/2
71 YD = R/2
75 XZ = R/2 
76 YZ = (R/2) * -1
77 YZ = YZ * 1.1
78 XZ = XZ * 1.1

85 X1 = X + (R * 10)
86 Y1 = Y + (R * 5)
87 C1 = 255 - C

90 MODE 1
100 CIRCLE XA,YA,R,0,F
101 CIRCLE X,Y,R,C,F

102 CIRCLE XB,YB,R,0,F
103 CIRCLE X1,Y1,R,C1,F

110 FOR LP = 0 TO S
115 NEXT LP

117 XA = X
118 YA = Y

121 XB = X1
122 YB = Y1

130 X = X + XD
140 IF X > 800-R THEN GOTO 150
145 IF X > 0+R THEN GOTO 200
150 XD = XD * - 1
160 C = 1+(RND(0)*254)

200 Y = Y + YD
210 IF Y > 480-R THEN GOTO 250
220 IF Y > 0+R THEN GOTO 300
250 YD = YD * - 1
260 C = 1+(RND(0)*254)

300 X1 = X1 + XZ
310 IF X1 > 800-R THEN GOTO 320
315 IF X1 > 0+R THEN GOTO 350
320 XZ = XZ * - 1
330 C1 = 1+(RND(0)*254)

350 Y1 = Y1 + YZ
360 IF Y1 > 480-R THEN GOTO 380
370 IF Y1 > 0+R THEN GOTO 500
380 YZ = YZ * - 1
390 C1 = 1+(RND(0)*254)

500 REM FUTURE BALL-BALL COLLISION


900 GOTO 100

