10 REM -- TEXT GAME OF LIFE
15 OUTK "--GoL--"
20 YM = 16
25 XM = 32
30 DIM L(YM,XM)
35 DIM N(YM,XM)
40 CLS

60 W = RND(0)


80 CLS
100 FOR I=1 TO YM
110   FOR J=1 TO XM
120     IF RND(0)>=.7 THEN N(I,J) = 1 ELSE N(I,J) = 0
130   NEXT J
140 NEXT I


1000 FOR I=0 TO YM+1
1010   CURSOR I,0 : PRINT "+";
1020   CURSOR I,XM+1 : PRINT "+";
1025 NEXT I
1027 FOR I = O TO XM+1
1030   CURSOR 0,I : PRINT "+";
1040   CURSOR YM+1,I : PRINT "+";
1050 NEXT I
1080 G=0
1085 OUTK "Cyc#"
1086 OUTK G


1090 CURSOR 0,YM+20 : PRINT "Cyc#";G
1100 FOR I=1 TO YM
1110   FOR J=1 TO XM
1115     W = N(I,J) : L(I,J) = W
1120     CURSOR I,J 
1130     IF W=0 THEN PRINT " "; ELSE PRINT "*";
1160   NEXT J
1170 NEXT I
1180 FOR I=1 TO YM
1190   FOR J=1 TO XM
1200     NC=0
1210     FOR K=I-1 TO I+1
1215       IF K=0 OR K>YM THEN GOTO 1260
1220       FOR W=J-1 TO J+1
1230         IF W=0 OR W>XM OR (K=I AND W=J) THEN 1250
1240         NC = NC + L(K,W)
1250       NEXT W
1260     NEXT K
1270     IF NC=2 THEN N(I,J)=L(I,J) : GOTO 1300
1280     IF NC=3 THEN N(I,J)=1 ELSE N(I,J)=0
1300   NEXT J
1310 NEXT I
1350 G=G+1
1355 OUTK "Cyc#"
1356 OUTK G
1360 GOTO 1090

