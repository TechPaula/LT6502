10 REM -- LT6502 ACIA TEST
50 SP = $BFE0
55 DT = SP      : REM DATA IN/OUT
60 SR = SP + 1  : REM STATUS REGISTER
65 CM = SP + 2  : REM COMMAND REGISTER
70 CT = SP + 3  : REM CONTROL REGISTER

90 GOSUB 1000


100 REM -- INIT ACIA
110 POKE ST,$00000000   : REM RESET
120 POKE CM,$0B         : REM TX INT DISABLED, IRQ DISABLED, DATA TERMINAL READY
130 POKE CT,$10         : REM 115200

150 GOSUB 1000

200 POKE DT,$48  : REM H



500 REM -- WAIT FOR CHAR LOOP
510 PRINT "STATUS:%";
515 PRINT BIN$(PEEK(SR),8);
520 PRINT " DATA:$";
525 PRINT HEX$(PEEK(DT),2)
530 GOSUB 1100
540 GOTO 500





999 END

1000 REM -- READ ALL REGISTERS
1005 PRINT "DATA:$";
1010 PRINT HEX$(PEEK(DT))
1015 PRINT "STATUS:$";
1020 PRINT BIN$(PEEK(SR),8)
1025 PRINT "COMMAND:$";
1030 PRINT BIN$(PEEK(CM),8)
1035 PRINT "CONTROL:$";
1040 PRINT BIN$(PEEK(CT),8)
1050 RETURN

1100 REM -- RELAY
1110 FOR T = 0 TO 200
1120 NEXT T
1130 RETURN
