10 REM -- MULTI BALL BOUNCE 
12 CT = RND(123456)
15 CLS
20 INPUT "START X:";XT
21 INPUT "START Y:";YT
20 XT = 200
21 YT = 200
22 INPUT "RADIUS:";R
23 CT = 255 : REM INPUT "COLOUR:";CT
24 INPUT "FILL [0=NO]:";F
25 INPUT "STEP SIZE [0-5]:";S
26 INPUT "NUMBER OF BALLS:"; BN
30 DIM X(BN)
31 DIM Y(BN)
32 DIM C(BN)
33 DIM XD(BN)
34 DIM YD(BN)
35 DIM XO(BN)
36 DIM YO(BN)

40 FOR BL = 0 TO BN-1
42 X(BL) = XT + (RND(0) * 600) + BL
43 Y(BL) = YT + (RND(0) * 400) + BL
44 C(BL) = 1+(RND(0)*254)

45 XD(BL) = R * S + 0.1
46 RN = RND(0)
47 IF RN > 0.5 GOTO 50
48 XD(BL) = XD(BL) * -1

50 YD(BL) = R * S + 0.1
51 RN = RND(0)
52 IF RN > 0.5 GOTO 60
53 YD(BL) = YD(BL) * -1

60 NEXT BL

98 CLS
99 MODE 1

100 FOR BL = 0 TO BN-1
101 CIRCLE XO(BL),YO(BL),R,0,F
105 CIRCLE X(BL),Y(BL),R,C(BL),F

117 XO(BL) = X(BL)
118 YO(BL) = Y(BL)

130 X(BL) = X(BL) + XD(BL)
140 IF X(BL) > 800-R THEN GOTO 150
145 IF X(BL) > 0+R THEN GOTO 200
150 XD(BL) = XD(BL) * -1
160 REM BEEP 255
170 C(BL) = 1+(RND(0)*254)

200 Y(BL) = Y(BL) + YD(BL)
210 IF Y(BL) > 480-R THEN GOTO 250
220 IF Y(BL) > 0+R THEN GOTO 280
250 YD(BL) = YD(BL) * -1
260 REM BEEP 0
270 C(BL) = 1+(RND(0)*254)

280 NEXT BL

300 GOTO 100

