 9000 REM ***************************************
 9001 REM * CONVERT BYTE TO HEX                 *
 9002 REM *************************************** 
 9003 REM
 9010 BH = INT(BY/16)
 9020 BL = BY - (BH*16)
 9030 B$ = MID$(H$,BH+1,1)+MID$(H$,BL+1,1)
 9040 RETURN
 9100 REM ***************************************
 9101 REM * CONVERT WORD TO HEX                 *
 9102 REM *************************************** 
 9103 REM
 9110 BY = INT(WD /256)
 9120 GOSUB 9000
 9130 WH$ = B$
 9140 BY = WD - (BY*256)
 9150 GOSUB 9000
 9160 WL$ = B$
 9170 W$ = WH$ + WL$
 9180 RETURN

