10 REM -----------------------------
11 REM RA8875 READ TEST
20 DT = $BFD0
21 RG = $BFD1
30 DA = 0        : REM DATA
31 TD = 0        : REM TEMP DATA
90 GOSUB 9000    : REM REGISTER DUMP


100 PX = 0
105 PY = 0
110 EX = 0
115 EY = 0
120 PC = %11100011

130 CLS


500 REM PATTERN
510 FOR TY = 0 TO 475 STEP 5
520 PY = TY
525 PX = 0
530 EX = TY
535 EY = 479
600 GOSUB 3000
610 NEXT TY



2999 END



3000 REM -- DRAW LINE
3001 REM USING PX, PY AND PC

3010 XM = PX >> 8
3012 TD = XM * 256
3013 XL = PX - TD

3020 YM = PY >> 8
3022 TD = YM * 256
3023 YL = PY - TD

3030 POKE RG,$91
3035 POKE DT,XL
3040 POKE RG,$92
3045 POKE DT,XM
3050 POKE RG,$93
3055 POKE DT,YL
3060 POKE RG,$94
3065 POKE DT,YM


3100 REM END

3110 XM = EX >> 8
3112 TD = XM * 256
3113 XL = EX - TD

3120 YM = EY >> 8
3122 TD = YM * 256
3123 YL = EY - TD

3170 POKE RG,$95
3175 POKE DT,XL
3180 POKE RG,$96
3185 POKE DT,XM
3190 POKE RG,$97
3195 POKE DT,YL
3200 POKE RG,$98
3205 POKE DT,YM

3210 REM - SPLIT COLOURS
3220 PR = PC >> 5
3222 TD = PR * 32
3224 PG = PC - TD
3226 PG = PG >> 2
3228 TD = PC >> 2
3230 TD = TD * 4
3232 PB = PC - TD

3240 POKE RG,$63
3245 POKE DT,PR
3250 POKE RG,$64
3255 POKE DT,PG
3260 POKE RG,$65
3265 POKE DT,PB

3270 POKE RG,$90
3271 POKE DT,$80
3280 TD = PEEK(DT)
3283 IF TD > 127 THEN GOTO 3280
3299 RETURN





8999 END


9000 REM --- DUMP ALL REGISTERS
9005 PRINT "REG dump:"
9006 TD = 0
9010 FOR L1 = 0 TO 15
9012 PRINT HEX$(L1*16,2);
9013 PRINT "-";
9014 PRINT HEX$((L1*16)+15,2);
9015 PRINT ": ";
9020 FOR L2 = 0 TO 15
9030 POKE RG,TD         : REM SET REG TO READ
9040 DA = PEEK(DT)      : REM READ REGISTER
9050 PRINT HEX$(DA,2);  : REM PRINT REG VALUE
9060 PRINT " ";
9070 TD=TD+1
9080 NEXT L2
9090 PRINT ""
9095 NEXT L1
9096 TD = 0
9099 RETURN

